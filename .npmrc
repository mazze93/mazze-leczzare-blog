# npm <11 silently drops the "libc" field from optionalDependencies entries
# when it rewrites package-lock.json, producing a spurious diff on every
# `npm install` (npm 10.9.x ships with Node 22 on some toolchains; this repo
# is pinned to Node 24 / npm 11+ via .nvmrc). engine-strict turns that silent
# lockfile corruption into a hard failure instead.
engine-strict=true
