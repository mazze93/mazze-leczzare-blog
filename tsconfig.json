{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "march_claude_blog",
    "blog-post-package",
    "files",
    "docs/field-notes/*/session-record/sources"
  ],
  "compilerOptions": {
    "strictNullChecks": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  }
}
