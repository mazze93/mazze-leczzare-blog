---
/**
 * HomepageLayout — fashion-editorial modern aesthetic
 * Loads homepage.css (Playfair Display + DM Sans + Tailwind utilities)
 * alongside global.css (via BaseHead) for shared tokens.
 * Sets data-layout="homepage" on <body> so CSS remaps the shared
 * --text/--rule/--header-bg vars to the deep editorial navy palette,
 * making Header + Footer auto-adapt with zero component changes.
 */
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/homepage.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Masthead-only header — for pages where AirlockStrip carries the nav. */
  minimalHeader?: boolean;
}

const { title, description, image, minimalHeader = false } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body data-layout="homepage">
    <Header minimal={minimalHeader} />
    <main class="homepage-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
/* Opt out of global.css's `main { width: 720px; ... }` prose constraint —
   BreathingHero and the writing index each manage their own full-bleed
   width, so the landmark itself must stay unconstrained. */
.homepage-main {
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 0;
}
</style>
