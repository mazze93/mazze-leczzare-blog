---
/**
 * /about — the quiet ledger.
 *
 * Label | content rows, a dated record, one portrait, and nothing selling.
 * The layout is borrowed from a plain editorial "about" pattern (big image,
 * then Info / Experience / record as two-column rows); what makes it this
 * site's is the seam: every break between chapters of the record is drawn as
 * the kintsugi gold line (Seam.astro), laid down as it scrolls into view.
 * The pivots are shown, mended, not smoothed over — the break is the record.
 *
 * Sourcing rule (carried over from the previous version of this page):
 * every date and claim below already exists on /work or in the CV PDF.
 * This page restates; it never introduces a fact. If a line here needs a
 * count or a status to work, it belongs on /work, where claims carry their
 * evidence tier. Dates are past tense and durable; no counts that go stale.
 *
 * Interaction: <SeamCursor /> (dot + spring-lagged gold ring) mounts here
 * only. It self-gates on fine pointer / reduced motion / forced colours.
 */
import { Picture } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seam from '../components/Seam.astro';
import SeamCursor from '../components/SeamCursor.astro';
import { SITE_EMAIL, SITE_GITHUB_URL } from '../consts';
// Imported from public/ (the same file AuthorCoda uses) so astro:assets can
// optimise it without committing a second copy of the binary.
import portrait from '../../public/mazze-headshot.jpg';

const securityEmail = SITE_EMAIL.replace('mailto:', '');

// ── The record ────────────────────────────────────────────────────────────
// Newest first. `years` omitted = an ongoing practice with no start date on
// the record (the CV dates Secure Pride, not the independent practice).
interface Role {
  org: string;
  role: string;
  years?: string;
  href?: string;
  /** Authored here, not user input — set:html so a phrase can carry <em>. */
  body: string[];
}

const roles: Role[] = [
  {
    org: 'Secure Pride',
    role: 'Founder & Executive Director',
    years: '2026 — Today',
    href: 'https://securepride.org',
    body: [
      'Secure Pride is a privacy-first cybersecurity nonprofit for LGBTQ+ and other at-risk civil-society organizations.',
      'I founded it and work on it as executive director and security engineer: a CLI-first audit suite, the Stonewall Standard DPA — a data-processing agreement published in both legal and plain English — and a threat toolkit for groups that have no security team. The rule under all of it: privacy has to be <em>enforced by the architecture</em>, not promised in a contract.',
    ],
  },
  {
    org: 'Independent',
    role: 'Security engineering & research',
    body: [
      'I build tools that can’t hide their own state. <a href="https://stratum.mazzeleczzare.com/">Stratum</a> is an append-only ledger that keeps evidence and claims apart. <a href="https://stele.mazzeleczzare.com/">STELE</a> compiles standing directives into constraints an AI session can’t quietly drift from. <a href="https://fieldnotes.mazzeleczzare.com/">Field Notes</a> is a gallery of small working instruments, one idea each.',
      'Alongside that, I take on client work: threat modeling, security architecture, and documentation that matches how a system actually behaves.',
    ],
  },
  {
    org: 'mudstack',
    role: 'Content & Community',
    years: '2022 — 2024',
    body: [
      'I was mudstack’s whole content function — technical posts, webinars, documentation, and <em>Clear as Mud</em>, a long-form interview podcast with studio directors, technical designers and founders about the parts of the work that don’t make the press release.',
    ],
  },
  {
    org: 'UC Davis · Luck Lab',
    role: 'Research & Lab Operations',
    years: '2018 — 2020',
    body: [
      'The Luck Lab at the Center for Mind & Brain is one of the defining EEG/ERP labs in cognitive neuroscience.',
      'I ran data collection for a counterfeit-banknote authentication program — EEG, eye-tracking and behavioral testing with community volunteers — and managed lab operations: participant pipelines, rig upkeep, data-integrity standards, and training new researchers to meet them. B.S. in Quantitative Psychology & Neuroscience, 2020; Regents Scholar.',
    ],
  },
  {
    org: 'Butte College',
    role: 'EOPS Tutor & Instructor · Founding Editor, Bloom',
    years: '2015 — 2018',
    body: [
      'I tutored re-entry students and taught math, science, English and history to students with learning and developmental disabilities — students the standard explanation had already failed once, which is the only real test of an explanation.',
      'I also founded <em>Bloom Magazine</em> as its first editor-in-chief, and wrote the grants that funded it.',
    ],
  },
];

// ── On the record ─────────────────────────────────────────────────────────
// Third-party acknowledgement only — the "Clients" row, for someone whose
// record lives in advisories, journals and trade press.
const onRecord: { what: string; where: string; href: string }[] = [
  { what: 'Acknowledged contributor', where: 'Dodgson & Raymond, Scientific Reports 12:2076 (2022)', href: 'https://doi.org/10.1038/s41598-022-05972-8' },
  { what: 'CVE-2026-59869', where: 'js-yaml — reported, high severity', href: 'https://github.com/advisories/GHSA-52cp-r559-cp3m' },
  { what: 'CVE-2026-59868', where: 'js-yaml — reported', href: 'https://github.com/advisories/GHSA-g796-fgmg-93mv' },
  { what: 'CVE-2026-53550', where: 'js-yaml — credited analysis', href: 'https://github.com/advisories/GHSA-h67p-54hq-rp68' },
  { what: '80 Level', where: 'Networking at GDC 2023', href: 'https://80.lv/articles/networking-at-gdc-2023-tips-for-artists-game-developers-and-industry-leaders' },
  { what: 'Intentional Fragility', where: 'Accountable Forgetting in Local-First AI (paper)', href: '/papers/intentional-fragility.pdf' },
];

const engagements: { name: string; detail: string }[] = [
  { name: 'Security architecture sprint', detail: '2–6 weeks. Threat modeling, control design, and incident runbooks for one critical system — for small teams pre-SOC 2, post-incident, or handling sensitive identity or health data.' },
  { name: 'Narrative & documentation', detail: 'Project-based or ongoing. Positioning, technical docs, and security pages that reflect how your system actually behaves.' },
  { name: 'Ongoing advisory', detail: 'Monthly or quarterly. Infrastructure review, content audit, and AI-governance check-ins with an explicit human-risk lens.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="About — Mazze LeCzzare"
      description="Mazze LeCzzare is a security engineer and writer in Durham, NC, and the founder of Secure Pride, a privacy-first cybersecurity nonprofit. Available for consulting."
    />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Mazze LeCzzare",
        "description": "Security engineer and writer; founder of Secure Pride, a privacy-first cybersecurity nonprofit.",
        "url": "https://mazzeleczzare.com",
        "image": "https://mazzeleczzare.com/mazze-headshot.jpg",
        "sameAs": [
          "https://github.com/mazze93",
          "https://securepride.org",
          "https://linkedin.com/in/mazze-leczzare"
        ],
        "jobTitle": "Security engineer",
        "worksFor": { "@type": "Organization", "name": "Secure Pride" },
        "alumniOf": { "@type": "CollegeOrUniversity", "name": "University of California, Davis" },
        "knowsAbout": ["Cybersecurity", "Threat modeling", "AI safety and privacy", "Technical writing", "Cognitive neuroscience"],
        "address": { "@type": "PostalAddress", "addressLocality": "Durham", "addressRegion": "NC", "addressCountry": "US" }
      }
    </script>
  </head>
  <body>
    <Header />
    <SeamCursor />

    <main class="ab" id="main">

      <!-- ── Masthead strip: who / where / now ── -->
      <div class="ab-strip">
        <p class="ab-strip__who">
          <span class="ab-strip__name">Mazze LeCzzare</span>
          <span class="ab-strip__where">
            Durham, NC&nbsp;<span aria-hidden="true">—</span>&nbsp;
            <time class="ab-clock" data-ab-clock>Eastern Time</time>
          </span>
        </p>
        <p class="ab-strip__status">
          <span class="ab-strip__dot" aria-hidden="true"></span>
          Available for consulting
        </p>
      </div>

      <!-- ── Portrait ── -->
      <figure class="ab-portrait">
        <Picture
          src={portrait}
          alt="Portrait of Mazze LeCzzare against a dark background."
          widths={[640, 1024, 1440, 2048]}
          sizes="(max-width: 1160px) 100vw, 1120px"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="ab-portrait__img"
        />
      </figure>
      <div class="ab-mend ab-mend--hero" data-mend>
        <Seam />
      </div>

      <h1 class="visually-hidden">About Mazze LeCzzare</h1>

      <!-- ── Info ── -->
      <section class="ab-row" aria-labelledby="ab-info">
        <h2 class="ab-row__label" id="ab-info">Info</h2>
        <div class="ab-row__body ab-prose">
          <p class="ab-lede">I’m Mazze LeCzzare, a security engineer and writer based in Durham, North Carolina.</p>
          <p>I run <a href="https://securepride.org">Secure Pride</a>, a privacy-first cybersecurity nonprofit for LGBTQ+ clinics, mutual aid groups and health services — people for whom a breach isn’t an inconvenience but an outing.</p>
          <p>I came to security from a neuroscience lab, by way of content and community work. I left the lab after years of measuring cognitive decline in aged macaques: the work produced clean numbers, and a gap between the data and the animals that I couldn’t live with.</p>
          <p>Everything since has been a way of answering the same three questions: who is this for, what can it see, and what happens when it fails them?</p>
          <p class="ab-coda">I build systems that break in the right places — and I’d rather show you the seam than hide it.</p>
        </div>
      </section>

      <!-- ── Work experience ── -->
      <section class="ab-row" aria-labelledby="ab-exp">
        <div class="ab-row__label">
          <h2 id="ab-exp">Work Experience</h2>
          <p class="ab-row__note">Gold marks the breaks between chapters — mended, not hidden.</p>
        </div>
        <ol class="ab-row__body ab-record">
          {roles.map((r, i) => (
            <li class="ab-role">
              {i > 0 && (
                <div class="ab-mend" data-mend aria-hidden="true"><Seam /></div>
              )}
              <div class="ab-role__head">
                <h3 class="ab-role__org">
                  {r.href ? <a href={r.href}>{r.org}</a> : r.org}
                </h3>
                {r.years && <p class="ab-role__years">{r.years}</p>}
              </div>
              <p class="ab-role__title">{r.role}</p>
              {r.body.map((p) => <p class="ab-role__body" set:html={p} />)}
            </li>
          ))}
        </ol>
      </section>

      <!-- ── On the record ── -->
      <section class="ab-row" aria-labelledby="ab-record">
        <div class="ab-row__label">
          <h2 id="ab-record">On the Record</h2>
          <p class="ab-row__note">Where someone else wrote it down. <a href="/work/">/work</a> has the full ledger, with evidence for each claim.</p>
        </div>
        <ul class="ab-row__body ab-cites">
          {onRecord.map((c) => (
            <li>
              <a href={c.href}>
                <span class="ab-cites__what">{c.what}</span>
                <span class="ab-cites__where">{c.where}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- ── Engagements ── -->
      <section class="ab-row" aria-labelledby="ab-work-with">
        <div class="ab-row__label">
          <h2 id="ab-work-with">Working Together</h2>
          <p class="ab-row__note">Not a fit for compliance theater, generic SEO content, or brand work without a technical foundation.</p>
        </div>
        <dl class="ab-row__body ab-engage">
          {engagements.map((e) => (
            <div class="ab-engage__item">
              <dt>{e.name}</dt>
              <dd>{e.detail}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- ── Outside ── -->
      <section class="ab-row" aria-labelledby="ab-outside">
        <h2 class="ab-row__label" id="ab-outside">Outside</h2>
        <div class="ab-row__body ab-prose">
          <p>I make music — Ableton, Logic, a Universal Audio Volt 2, and a Martin acoustic-electric named Joni — and I write speculative fiction and poetry.</p>
        </div>
      </section>

      <!-- ── Contact ── -->
      <section class="ab-row" aria-labelledby="ab-contact">
        <h2 class="ab-row__label" id="ab-contact">Contact</h2>
        <div class="ab-row__body">
          <p class="ab-prose ab-contact__lede">The fastest way to reach me is the <a href="/contact/">contact form</a>. Security reports go to <a href={SITE_EMAIL}>{securityEmail}</a>.</p>
          <ul class="ab-links">
            <li><a href="/work/">Selected work</a></li>
            <li><a href="/mazze-leczzare-cv.pdf" type="application/pdf">CV <span class="ab-links__meta">PDF</span></a></li>
            <li><a href={SITE_GITHUB_URL}>GitHub</a></li>
            <li><a href="https://linkedin.com/in/mazze-leczzare">LinkedIn</a></li>
          </ul>
        </div>
      </section>

      <p class="ab-colophon">
        This site runs on <a href="/cipher-gothic/">Cipher Gothic</a> — a design language for systems made intimate.
      </p>
    </main>

    <Footer />

    <script>
      // ── Local clock ── Durham time, like a studio door sign. Side effect:
      // writes textContent of [data-ab-clock] every 30s. Falls back to the
      // static "Eastern Time" label if Intl or the element is missing.
      const clock = document.querySelector<HTMLTimeElement>('[data-ab-clock]');
      const fmt = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/New_York',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      });
      const renderClock = (): void => {
        if (!clock) return;
        const now = new Date();
        clock.textContent = `${fmt.format(now).replace(',', ' ·')} ET`;
        clock.dateTime = now.toISOString();
      };
      renderClock();
      window.setInterval(renderClock, 30_000);

      // ── Seams laid down on arrival ── Each [data-mend] pauses its seam's
      // draw animation until it scrolls into view. JS-only: without this
      // script the attribute never becomes "pending", so seams draw on load.
      const mends = document.querySelectorAll<HTMLElement>('[data-mend]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              (e.target as HTMLElement).dataset.mend = 'laid';
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px' },
        );
        mends.forEach((m) => {
          m.dataset.mend = 'pending';
          io.observe(m);
        });
      }
    </script>
  </body>
</html>

<style>
  /* ═══ About — quiet ledger ═════════════════════════════════════════════
     Tokens only (Kintsugi dark / Haven-Ink light via global.css). No new
     fonts: Cormorant Garamond carries the prose, DM Mono the apparatus. ═══ */

  .ab {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 28px 24px 48px;
    color: var(--text);
    -webkit-font-smoothing: antialiased;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Links: underlined at rest so they never rely on colour alone. */
  /* :global(a) so links injected via set:html (the record) match too. */
  .ab :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(var(--gold-rgb), 0.55);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color var(--transition-fast), color var(--transition-fast);
  }
  .ab :global(a:hover) { color: var(--gold); text-decoration-color: var(--gold); }
  .ab :global(a:focus-visible) {
    outline: 2px solid var(--teal);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* ── Strip ── */
  .ab-strip {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 18px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }
  .ab-strip p { margin: 0; }
  .ab-strip__who { display: flex; flex-direction: column; gap: 2px; }
  .ab-strip__name { color: var(--text); }
  .ab-strip__where { color: var(--text-faint); }
  .ab-strip__status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-dim);
  }
  .ab-strip__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.15);
  }

  /* ── Portrait ──
     Monochrome at rest; colour comes back while you're looking at it.
     Wide crop on desktop, near-square on phones. */
  .ab-portrait {
    margin: 0;
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface);
    aspect-ratio: 16 / 8;
  }
  .ab-portrait :global(.ab-portrait__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
    filter: grayscale(1) contrast(1.06);
    transition: filter 1.1s ease;
  }
  .ab-portrait:hover :global(.ab-portrait__img) { filter: grayscale(0) contrast(1); }

  /* ── Seams (mends) ── */
  /* Seam's viewBox is 340×22; at full column width its natural height would
     balloon, so pin the height and let preserveAspectRatio="none" stretch
     the brush lengthwise only — a longer stroke, same weight. */
  .ab-mend { width: 100%; height: 12px; }
  .ab-mend :global(.seam--h) { height: 100%; }
  .ab-mend--hero { height: 16px; }
  .ab-mend--hero { margin: 14px 0 0; }
  .ab-mend[data-mend="pending"] :global(.seam--draw) { animation-play-state: paused; }

  /* ── Rows: label | content ── */
  .ab-row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px;
    padding: 72px 0;
    border-top: 1px solid var(--rule);
  }
  .ab-mend--hero + h1 + .ab-row { border-top: 0; }

  .ab-row__label,
  .ab-row__label h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.2;
    color: var(--text);
  }
  .ab-row__label { align-self: start; position: sticky; top: 96px; }
  .ab-row__note {
    margin: 12px 0 0;
    max-width: 22rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.7;
    color: var(--text-faint);
  }

  .ab-row__body { margin: 0; padding: 0; min-width: 0; }

  /* ── Prose ── */
  .ab-prose p,
  .ab-prose.ab-contact__lede {
    margin: 0 0 1.1em;
    font-family: var(--font-display);
    font-size: 1.28rem;
    line-height: 1.6;
    color: var(--text-dim);
  }
  .ab-prose p:last-child { margin-bottom: 0; }
  .ab-prose .ab-lede { color: var(--text); font-size: 1.5rem; line-height: 1.45; }
  .ab-prose .ab-coda {
    margin-top: 1.6em;
    padding-left: 16px;
    border-left: 1px solid var(--gold-seam);
    font-style: italic;
    color: var(--text);
  }

  /* ── Record ── */
  .ab-record { list-style: none; }
  .ab-role .ab-mend { margin: 44px 0 40px; }
  .ab-role:first-child { padding-top: 0; }

  .ab-role__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }
  .ab-role__org {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--text);
  }
  .ab-role__years {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ab-role__title {
    margin: 6px 0 16px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
  }
  /* Light mode: --gold (#8a6a3a) is 4.40:1 on paper — under AA for this
     small uppercase label. --gold-seam-deep (#6f5628) clears it. */
  :global([data-theme="light"]) .ab-role__title { color: var(--gold-seam-deep); }

  .ab-role__body {
    margin: 0 0 0.9em;
    font-family: var(--font-display);
    font-size: 1.18rem;
    line-height: 1.62;
    color: var(--text-dim);
  }
  .ab-role__body:last-child { margin-bottom: 0; }
  .ab-role__body :global(em) { color: var(--text); }

  /* ── Citations ── */
  .ab-cites { list-style: none; }
  .ab-cites li { border-bottom: 1px solid var(--rule); }
  .ab-cites li:first-child { border-top: 1px solid var(--rule); }
  .ab .ab-cites a {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 16px;
    padding: 16px 2px;
    text-decoration: none;
    min-height: 44px;
  }
  .ab-cites__what {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--text);
  }
  .ab-cites__where {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.6;
    color: var(--text-faint);
    align-self: center;
  }
  .ab .ab-cites a:hover .ab-cites__what { color: var(--gold); }
  .ab .ab-cites a:hover .ab-cites__where { color: var(--text-dim); }

  /* ── Engagements ── */
  .ab-engage__item { padding: 0 0 22px; }
  .ab-engage__item:last-child { padding-bottom: 0; }
  .ab-engage dt {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--text);
    margin-bottom: 4px;
  }
  .ab-engage dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.75;
    color: var(--text-dim);
  }

  /* ── Contact ── */
  .ab-links {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .ab-links a { display: inline-flex; align-items: center; min-height: 44px; }
  .ab-links__meta { margin-left: 0.6ch; font-size: 0.68rem; color: var(--text-faint); }

  .ab-colophon {
    margin: 0;
    padding: 32px 0 0;
    border-top: 1px solid var(--rule);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }

