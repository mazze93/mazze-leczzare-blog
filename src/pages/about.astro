---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="About — Mazze LeCzzare"
      description="Security engineer, content strategist, and founder of Secure Pride. Infrastructure and story for systems with real human stakes."
    />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Mazze LeCzzare",
        "description": "Security engineer, content strategist, and founder of Secure Pride, building infrastructure and narrative for high-stakes systems.",
        "url": "https://mazzeleczzare.com",
        "sameAs": [
          "https://github.com/mazze93",
          "https://securepride.org",
          "https://linkedin.com/in/mazze-leczzare"
        ],
        "jobTitle": "Security engineer and content strategist",
        "worksFor": {
          "@type": "Organization",
          "name": "Secure Pride"
        },
        "knowsAbout": [
          "Cybersecurity",
          "LGBTQ+ organizations",
          "AI safety and privacy",
          "Developer tools",
          "Technical writing"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Durham",
          "addressRegion": "NC",
          "addressCountry": "US"
        }
      }
    </script>
  </head>
  <body>
    <Header />

    <div class="about-page">
      <div class="about-shell">
        <main class="about-main">

          <!-- HERO -->
          <section class="about-hero" aria-labelledby="about-hero-title">
            <div class="about-hero__left">
              <h1 id="about-hero-title" class="about-hero__title">
                Security engineering and narrative for organizations whose systems touch people who can't afford a leak.
              </h1>
              <p class="about-hero__subtitle">
                I'm a security engineer, content strategist, and founder of <strong>Secure Pride</strong> — a privacy-first cybersecurity nonprofit for LGBTQ+ clinics, mutual aid orgs, and health services.
              </p>
              <p class="about-hero__tagline">
                My work starts from three questions: who is this for, what can it see, and what happens when it fails them. If those questions matter to your team, we should talk.
              </p>
              <div class="about-hero__tags" aria-label="Disciplines">
                <span class="ab-tag-pill">
                  <span class="ab-tag-pill__dot" aria-hidden="true"></span>
                  Security engineering
                </span>
                <span class="ab-tag-pill">
                  <span class="ab-tag-pill__dot" aria-hidden="true"></span>
                  Infrastructure systems
                </span>
                <span class="ab-tag-pill">
                  <span class="ab-tag-pill__dot" aria-hidden="true"></span>
                  Content &amp; narrative
                </span>
              </div>
            </div>
            <aside class="about-hero__meta">
              <div class="about-hero__meta-top">
                <div class="ab-meta-label">Location</div>
                <div class="ab-meta-value">Durham, North Carolina</div>
                <div class="about-hero__meta-tags">
                  <span class="ab-tag-pill">
                    <span class="ab-tag-pill__dot" aria-hidden="true"></span>
                    Available for consulting
                  </span>
                  <span class="ab-tag-pill">
                    <span class="ab-tag-pill__dot" aria-hidden="true"></span>
                    Remote &amp; hybrid
                  </span>
                </div>
              </div>
              <div class="about-hero__cta-group">
                <a class="ab-button-primary" href="mailto:hello@mazzeleczzare.com" aria-label="Primary contact CTA">
                  <span class="ab-dot"></span>
                  Work together
                </a>
                <a class="ab-button-ghost" href="/work/">
                  <span class="ab-dot"></span>
                  View projects
                </a>
              </div>
            </aside>
          </section>

          <!-- WHAT I'M WORKING ON -->
          <section class="about-section" aria-labelledby="section-work-title">
            <div class="about-section__header">
              <div>
                <div class="about-section__eyebrow">Current work</div>
                <h2 id="section-work-title" class="about-section__title">What I'm working on</h2>
              </div>
              <p class="about-section__hint">Security, infra, and narrative work with explicit human stakes.</p>
            </div>

            <div class="about-grid">
              <article class="ab-work-card">
                <div class="ab-work-card__title-row">
                  <h3 class="ab-work-card__title">Secure Pride</h3>
                  <span class="ab-work-card__badge ab-work-card__badge--accent">Active — nonprofit</span>
                </div>
                <p class="ab-work-card__body">
                  Secure Pride exists because LGBTQ+ nonprofits, clinics, and mutual aid orgs handle data with real consequences — identity disclosures, health records, the coordinates of people living in hostile conditions — and almost none of them have adequate protection.
                </p>
                <ul class="ab-work-card__list">
                  <li>Designing certificate-based network authentication and device access paths sized for teams without dedicated IT.</li>
                  <li>Hardening workstations and cloud services that handle sensitive health and identity data.</li>
                  <li>Writing security playbooks and plain-language documentation that non-technical staff can actually follow.</li>
                </ul>
                <p class="ab-work-card__cta">
                  Learn more at <a href="https://securepride.org" target="_blank" rel="noreferrer">securepride.org</a>
                </p>
              </article>

              <div class="about-grid__side">
                <article class="ab-work-card ab-work-card--secondary">
                  <div class="ab-work-card__title-row">
                    <h3 class="ab-work-card__title">Context Synapse</h3>
                    <span class="ab-work-card__badge">Research — Swift</span>
                  </div>
                  <p class="ab-work-card__body">
                    Context Synapse is a local-first context orchestration framework in Swift — a Bayesian system for managing what a model knows about you across time, without that data ever leaving your device. Research project and values statement, simultaneously.
                  </p>
                  <ul class="ab-work-card__list">
                    <li>Local-only state and context graphs to avoid cloud exfiltration of personal history.</li>
                    <li>Probabilistic modeling of long-term preferences and memory without centralizing raw data.</li>
                    <li>Interfaces for interrogating and correcting what the system thinks it knows about you.</li>
                  </ul>
                </article>

                <article class="ab-work-card ab-work-card--secondary" aria-label="Client work">
                  <div class="ab-work-card__title-row">
                    <h3 class="ab-work-card__title">Client work</h3>
                    <span class="ab-work-card__badge">Select engagements</span>
                  </div>
                  <p class="ab-work-card__body">
                    Client work sits at the intersection of infrastructure and story. I partner with developer platforms, security-forward products, and mission-driven orgs whose systems touch sensitive data or communities poorly served by default frameworks.
                  </p>
                  <ul class="ab-work-card__list">
                    <li>Security architecture and threat modeling for a dev-tool startup building toward enterprise-grade controls on a startup budget — resulted in documented incident response paths and a revised access control model.</li>
                    <li>Narrative and positioning rebuild for a security-forward product whose public claims had drifted from its production behavior — aligned docs, security page, and sales copy to actual system architecture.</li>
                    <li>50+ episodes of <em>Clear as Mud</em> at mudstack — technical interviews with engineers from Epic, Riot, Sony, and Meta VR; audience growth from zero to established developer media property.</li>
                  </ul>
                  <p class="client-note">Not a fit for: generic SEO content, compliance theater, or brand work without a technical foundation. If your system has real stakes, email is the right first step.</p>
                  <p class="ab-work-card__cta">
                    For availability, email <a href="mailto:hello@mazzeleczzare.com">hello@mazzeleczzare.com</a>
                  </p>
                </article>
              </div>
            </div>
          </section>

          <!-- HOW I THINK -->
          <section class="about-section" aria-labelledby="section-thinking-title">
            <div class="about-section__header">
              <div>
                <div class="about-section__eyebrow">How I think</div>
                <h2 id="section-thinking-title" class="about-section__title">From lab notes to infrastructure</h2>
              </div>
            </div>
            <div class="about-grid">
              <div>
                <div class="ab-narrative-block">
                  <p>
                    I left a neuroscience lab after years of measuring cognitive decline in aged macaques — running behavioral tests, recording scores, eventually preparing their brains for post-mortem analysis. The work produced clean numbers. The numbers became figures in papers. At some point, the distance between the data and the animals stopped being something I could live with.
                  </p>
                  <p>
                    Everything since has been an attempt to work where the stakes are explicit and the humans are not an afterthought. Secure Pride, Context Synapse, and the systems I write about all start from the same questions: who is this for, what can it see, and what happens when it fails them?
                  </p>
                </div>
              </div>
              <aside>
                <div class="ab-narrative-block ab-narrative-block--serif">
                  <p>
                    This site refuses to separate technical writing from literary work. Infrastructure and story are the same problem told in different grammars, and the job is to make both legible to the people who depend on them.
                  </p>
                </div>
              </aside>
            </div>
          </section>

          <!-- BACKGROUND -->
          <section class="about-section" aria-labelledby="section-background-title">
            <div class="about-section__header">
              <div>
                <div class="about-section__eyebrow">Background</div>
                <h2 id="section-background-title" class="about-section__title">Where I've worked and learned</h2>
              </div>
            </div>
            <div class="about-grid">
              <div class="ab-background-list">
                <p>
                  Cognitive neuroscience and quantitative psychology at UC Davis — EEG/ERP, eye tracking, and representational similarity analysis in the Luck Lab. That work didn't pull me toward writing; it sharpened how I think about noisy systems, experimental design, and the gap between statistically significant and actually meaningful.
                </p>
                <p>
                  Before Secure Pride: content lead at mudstack, over fifty episodes of <em>Clear as Mud</em> with guests from Epic, Riot, Sony, and Meta VR, and growth work at Tennis 919. Alongside that, a long-running habit of building lab infrastructure and open-source tools for my own work.
                </p>
              </div>
              <aside class="ab-background-list">
                <p>
                  I make music — Ableton, Logic, a Universal Audio Volt 2, and a Martin acoustic-electric named Joni. I write speculative fiction. I'm based in Durham, NC, working across time zones with teams who treat security and narrative as first-class concerns.
                </p>
              </aside>
            </div>
          </section>

          <!-- CONTACT -->
          <section class="about-section" aria-labelledby="section-contact-title">
            <div class="about-section__header">
              <div>
                <div class="about-section__eyebrow">Work with me</div>
                <h2 id="section-contact-title" class="about-section__title">How we might collaborate</h2>
              </div>
            </div>
            <div class="ab-cta-panel">
              <div class="ab-cta-panel__headline">Currently open to</div>
              <p class="ab-cta-panel__body">
                Security and infrastructure consulting for small teams, narrative and content strategy for developer tools, and collaborations with organizations whose systems touch vulnerable communities or sensitive data.
              </p>

              <div class="ab-engagement-grid">
                <div class="ab-engagement-card">
                  <div class="ab-engagement-card__label">Security Architecture Sprint</div>
                  <p class="ab-engagement-card__detail">2–6 weeks. Threat modeling, control design, and incident runbooks for one critical system. Best for: small teams pre-SOC2, post-incident, or building something that touches sensitive identity or health data.</p>
                </div>
                <div class="ab-engagement-card">
                  <div class="ab-engagement-card__label">Narrative + Documentation</div>
                  <p class="ab-engagement-card__detail">Ongoing or project-based. Positioning, technical docs, and security pages that reflect how your system actually behaves. Best for: infra and security products whose copy has drifted from their architecture.</p>
                </div>
                <div class="ab-engagement-card">
                  <div class="ab-engagement-card__label">Ongoing Advisory</div>
                  <p class="ab-engagement-card__detail">Quarterly or monthly. Infra review, content audit, and AI governance check-in with an explicit human-risk lens. Best for: orgs that need a security + narrative voice without a full-time hire.</p>
                </div>
              </div>

              <div class="ab-cta-panel__channels">
                <a class="ab-cta-pill" href="mailto:hello@mazzeleczzare.com">
                  <span class="ab-cta-pill__dot" aria-hidden="true"></span>
                  Email — hello@mazzeleczzare.com
                </a>
                <a class="ab-cta-pill" href="mailto:security@mazzeleczzare.com">
                  <span class="ab-cta-pill__dot" aria-hidden="true"></span>
                  Security inquiries
                </a>
                <a class="ab-cta-pill" href="https://github.com/mazze93" target="_blank" rel="noreferrer">
                  <span class="ab-cta-pill__dot" aria-hidden="true"></span>
                  GitHub
                </a>
                <a class="ab-cta-pill" href="https://linkedin.com/in/mazze-leczzare" target="_blank" rel="noreferrer">
                  <span class="ab-cta-pill__dot" aria-hidden="true"></span>
                  LinkedIn
                </a>
              </div>
            </div>
          </section>

        </main>
        <p class="about-footer-note">
          This site runs on <a href="/cipher-gothic/">Cipher Gothic →</a> — a design language for systems made intimate.
        </p>
      </div>
    </div>

    <Footer />
  </body>
</html>

<style>
  /* ── About page — Cipher Gothic tokens ────────────────────────────────
     No bespoke palette or typefaces: this page consumes the same
     --teal / --coral / --font-display / --font-mono system as /work,
     /project/[slug], and the rest of the editorial surface. ── */
  .about-page {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    -webkit-font-smoothing: antialiased;
    min-height: 60vh;
  }

  .about-shell {
    width: 100%;
    max-width: 1040px;
    margin: 0 auto;
    padding: 24px 24px 64px;
  }

  .about-main {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* ── Hero ── */
  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 28px;
    align-items: flex-start;
    padding: 24px 20px;
    border-radius: 24px;
    background:
      linear-gradient(145deg, rgba(var(--accent-rgb), 0.05), var(--surface)),
      radial-gradient(circle at 0 0, rgba(var(--accent-rgb), 0.14), transparent 55%);
    border: 1px solid rgba(var(--accent-rgb), 0.16);
    box-shadow: var(--shadow-md);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .about-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 0 0, rgba(var(--accent-rgb), 0.1), transparent 55%),
      linear-gradient(120deg, rgba(var(--accent-rgb), 0.04) 0, transparent 40%),
      repeating-linear-gradient(
        to right,
        var(--rule),
        var(--rule) 0.5px,
        transparent 1px,
        transparent 9px
      );
    mask-image: radial-gradient(circle at 10% 0, rgba(0, 0, 0, 0.6), transparent 70%);
    opacity: 0.7;
    pointer-events: none;
    z-index: -1;
  }

  .about-hero__title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.4vw, 2.6rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
    margin: 0 0 12px;
    color: var(--text);
  }

  .about-hero__subtitle {
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-dim);
    margin-bottom: 16px;
  }

  .about-hero__subtitle strong { color: var(--text); font-weight: 500; }

  .about-hero__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--text-dim);
    line-height: 1.8;
    max-width: 30rem;
  }

  .about-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .about-hero__meta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-end;
    justify-content: space-between;
  }

  .about-hero__meta-top {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .about-hero__meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-end;
    margin-top: 6px;
  }

  .about-hero__cta-group {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    margin-top: 12px;
  }

  .ab-meta-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--text-faint);
  }

  .ab-meta-value {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text);
  }

  /* ── Tag pills ── */
  .ab-tag-pill {
    border-radius: 999px;
    border: 1px solid var(--rule);
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-dim);
    background: var(--surface);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .ab-tag-pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--teal);
    flex-shrink: 0;
  }

  /* ── Buttons ── */
  .ab-button-primary,
  .ab-button-ghost {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    border-radius: 999px;
    padding: 8px 16px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 8px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: opacity var(--transition-fast), border-color var(--transition-fast);
  }

  .ab-button-primary:hover,
  .ab-button-ghost:hover { opacity: 0.85; }

  .ab-button-primary:focus-visible,
  .ab-button-ghost:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 3px;
  }

  .ab-button-primary {
    background: rgba(var(--accent-rgb), 0.14);
    border-color: var(--teal);
    color: var(--text);
  }

  .ab-button-ghost {
    border-color: var(--rule);
    color: var(--text-dim);
    background: var(--surface);
  }

  .ab-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  /* ── Sections ── */
  .about-section {
    padding: 16px 4px 0;
    border-top: 1px solid var(--rule);
    margin-top: 12px;
  }

  .about-section__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .about-section__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 4px;
  }

  .about-section__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--text);
    margin: 0;
  }

  .about-section__hint {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    margin: 0;
  }

  /* ── Grid ── */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 24px;
  }

  .about-grid__side {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ── Work cards ── */
  .ab-work-card {
    border-radius: var(--radius-md);
    background:
      radial-gradient(circle at 0 0, rgba(var(--accent-rgb), 0.09), transparent 55%),
      var(--surface);
    border: 1px solid var(--rule);
    padding: 18px 18px 16px;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .ab-work-card--secondary {
    background: var(--surface);
    background-image: none;
  }

  .ab-work-card__title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  .ab-work-card__title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--text);
    margin: 0;
  }

  .ab-work-card__badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .ab-work-card__badge--accent {
    border-color: var(--teal);
    color: var(--teal);
    background: rgba(var(--accent-rgb), 0.08);
  }

  .ab-work-card__body {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.75;
    color: var(--text-dim);
    margin-bottom: 10px;
    margin-top: 0;
  }

  .ab-work-card__list {
    margin: 0 0 10px;
    padding-left: 16px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-dim);
    line-height: 1.65;
  }

  .ab-work-card__list li + li { margin-top: 4px; }
  .ab-work-card__list em { color: var(--text); font-style: italic; }

  .ab-work-card__cta {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .ab-work-card__cta a {
    color: var(--teal);
    text-decoration: none;
  }

  .ab-work-card__cta a:hover { text-decoration: underline; }

  .ab-work-card__cta a:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* ── Narrative blocks ── */
  .ab-narrative-block {
    border-radius: var(--radius-md);
    padding: 18px 18px 16px;
    border: 1px solid var(--rule);
    background:
      radial-gradient(circle at 0 0, rgba(var(--accent-rgb), 0.06), transparent 55%),
      var(--surface);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.8;
    color: var(--text-dim);
    height: 100%;
    box-sizing: border-box;
  }

  .ab-narrative-block p { margin: 0 0 10px; }
  .ab-narrative-block p:last-child { margin-bottom: 0; }

  .ab-narrative-block--serif {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  /* ── Background list ── */
  .ab-background-list {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--text-dim);
  }

  .ab-background-list p { margin: 0 0 8px; }
  .ab-background-list em { color: var(--text); font-style: italic; }

  /* ── CTA panel ── */
  .ab-cta-panel {
    border-radius: var(--radius-md);
    padding: 18px 20px 16px;
    border: 1px solid var(--rule);
    background:
