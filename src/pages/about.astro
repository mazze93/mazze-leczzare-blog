---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_EMAIL } from '../consts';

const securityEmail = SITE_EMAIL.replace('mailto:', '');
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="About — Mazze LeCzzare"
      description="Security engineering and narrative for systems with real human stakes. Security architecture, threat modeling, and documentation that matches it — Durham, NC, remote and hybrid. Available for consulting."
    />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Mazze LeCzzare",
        "description": "Security engineer, content strategist, and founder of Secure Pride, building infrastructure and narrative for high-stakes systems.",
        "url": "https://mazzeleczzare.com",
        "sameAs": [
          "https://github.com/mazze93",
          "https://securepride.org",
          "https://linkedin.com/in/mazze-leczzare"
        ],
        "jobTitle": "Security engineer and content strategist",
        "worksFor": {
          "@type": "Organization",
          "name": "Secure Pride"
        },
        "knowsAbout": [
          "Cybersecurity",
          "LGBTQ+ organizations",
          "AI safety and privacy",
          "Developer tools",
          "Technical writing"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Durham",
          "addressRegion": "NC",
          "addressCountry": "US"
        }
      }
    </script>
  </head>
  <body>
    <Header />

    <div class="about-page">
      <div class="about-shell">
        <main class="about-main">

          <!-- HERO -->
          <section class="about-hero" aria-labelledby="about-hero-title">
            <div class="about-hero__left">
              <h1 id="about-hero-title" class="about-hero__title">
                Security engineering and narrative for systems with real human stakes.
              </h1>
              <p class="about-hero__lede">
                I work with teams whose infrastructure touches people who can't afford a leak.
              </p>
              <p class="about-hero__subtitle">
                I'm a security engineer, content strategist, and founder of <strong>Secure Pride</strong> — a privacy-first cybersecurity nonprofit for LGBTQ+ clinics, mutual aid orgs, and health services.
              </p>
              <p class="about-hero__tagline">
                My work starts from three questions: who is this for, what can it see, and what happens when it fails them.
              </p>
              <div class="about-hero__tags" aria-label="Disciplines">
                <span class="ab-tag-pill">
                  <span class="ab-tag-pill__dot" aria-hidden="true"></span>
                  Security engineering
                </span>
                <span class="ab-tag-pill">
                  <span class="ab-tag-pill__dot" aria-hidden="true"></span>
                  Infrastructure systems
                </span>
                <span class="ab-tag-pill">
                  <span class="ab-tag-pill__dot" aria-hidden="true"></span>
                  Content &amp; narrative
                </span>
              </div>
            </div>
            <aside class="about-hero__meta">
              <div class="about-hero__meta-top">
                <div class="ab-meta-label">Location</div>
                <div class="ab-meta-value">Durham, North Carolina</div>
                <div class="about-hero__meta-tags">
                  <span class="ab-tag-pill">
                    <span class="ab-tag-pill__dot" aria-hidden="true"></span>
                    Available for consulting
                  </span>
                  <span class="ab-tag-pill">
                    <span class="ab-tag-pill__dot" aria-hidden="true"></span>
                    Remote &amp; hybrid
                  </span>
                </div>
              </div>
              <div class="about-hero__cta-group">
                <a class="ab-button-primary" href="/contact/">
                  <span class="ab-dot"></span>
                  Start a security engagement
                </a>
                <a class="ab-button-ghost" href="/work/">
                  <span class="ab-dot"></span>
                  View selected work
                </a>
                <a
                  class="ab-button-ghost"
                  href="/mazze-leczzare-cv.pdf"
                  type="application/pdf"
                >
                  <span class="ab-dot"></span>
                  Download CV <span class="ab-button-ghost__meta">PDF</span>
                </a>
              </div>
            </aside>
          </section>

          <!-- WHAT I'M WORKING ON -->
          <section class="about-section" aria-labelledby="section-work-title">
            <div class="about-section__header">
              <div>
                <div class="about-section__eyebrow cg-eyebrow">Current work</div>
                <h2 id="section-work-title" class="about-section__title">What I'm working on</h2>
              </div>
              <p class="about-section__hint">Orientation, not the record — <a href="/work/">/work</a> carries that, with the evidence for each claim.</p>
            </div>

            {/*
              Deliberately thin. This section used to carry status badges and
              nine bullets across three cards, which made it a second, worse
              copy of /work — and every badge and bare count was a fact that
              could go stale silently. One did: it claimed "50+ episodes" of a
              podcast that ran 26. /work tiers its claims and links its
              evidence; this page only has to say what the work is and get out
              of the way. Keep it to one durable sentence per card. If a
              sentence here needs a number or a status to work, it belongs on
              /work instead.
            */}
            <div class="about-grid">
              <article class="ab-work-card">
                <h3 class="ab-work-card__title">Secure Pride</h3>
                <p class="ab-work-card__body">
                  A privacy-first cybersecurity nonprofit for LGBTQ+ clinics, mutual aid orgs, and health services — people for whom a breach is not an inconvenience but an outing. I founded it and work on it as security engineer.
                </p>
                <p class="ab-work-card__cta">
                  <a href="https://securepride.org" target="_blank" rel="noreferrer">securepride.org</a>
                </p>
              </article>

              <div class="about-grid__side">
                <article class="ab-work-card ab-work-card--secondary" aria-label="Client work">
                  <h3 class="ab-work-card__title">Client work</h3>
                  <p class="ab-work-card__body">
                    Security architecture, threat modeling, and the documentation that has to match it — for teams whose systems touch sensitive data or communities poorly served by default frameworks.
                  </p>
                  <p class="client-note">Not a fit for generic SEO content, compliance theater, or brand work without a technical foundation.</p>
                </article>

                <article class="ab-work-card ab-work-card--secondary">
                  <h3 class="ab-work-card__title">Context Synapse</h3>
                  <p class="ab-work-card__body">
                    A local-first context framework in Swift: modeling what a system has learned about you over time, on-device, with a way to interrogate and correct what it thinks it knows.
                  </p>
                </article>
              </div>
            </div>
          </section>

          <!-- HOW I THINK -->
          <section class="about-section" aria-labelledby="section-thinking-title">
            <div class="about-section__header">
              <div>
                <div class="about-section__eyebrow cg-eyebrow">How I think</div>
                <h2 id="section-thinking-title" class="about-section__title">From lab notes to infrastructure</h2>
              </div>
            </div>
            <div class="about-grid">
              <div>
                <div class="ab-narrative-block">
                  <p>
                    Everything I do starts from an explicit sense of stakes, and from humans who are not an afterthought.
                  </p>
                  <p>
                    I left a neuroscience lab after years of measuring cognitive decline in aged macaques — work that produced clean numbers and publishable figures, but left a gap between the data and the animals I couldn't live with. Since then, Secure Pride, Context Synapse, and my client work have all been different ways of answering the same questions: who is this for, what can it see, and what happens when it fails them?
                  </p>
                </div>
              </div>
              <aside>
                <div class="ab-narrative-block ab-narrative-block--serif">
                  <p>
                    The essays and the runbooks come from the same instinct: say exactly what's true, cut what isn't load-bearing, and never let the polish outrun the substance.
                  </p>
                </div>
              </aside>
            </div>
          </section>

          {/*
            The long BACKGROUND section was replaced by this stub. Its facts —
            Luck Lab, EEG/ERP, ERPLAB, lab operations, teaching, Clear as Mud —
            are all on /work now, tiered and with evidence links, so repeating
            them here was a second unsourced copy of a record that has a
            sourced one. Two things did NOT survive to /work and live only in
            git history: growth work at Tennis 919, and the music/fiction line
            below, which is kept because a hiring surface still has to sound
            like a person.
          */}
          <!-- BACKGROUND (condensed — see docblock above) -->
          <section class="about-section" aria-labelledby="section-cv-title">
            <div class="about-section__header">
              <div>
                <div class="about-section__eyebrow cg-eyebrow">Background</div>
                <h2 id="section-cv-title" class="about-section__title">The full history</h2>
              </div>
            </div>
            <div class="ab-background-list">
              <p>
                Labs, tools, podcasts, and past roles — <a href="/mazze-leczzare-cv.pdf">the CV</a> has the record in order, and <a href="/work/">/work</a> has it with the evidence for each claim.
              </p>
              <p>
                Outside of that: I make music — Ableton, Logic, a Universal Audio Volt 2, and a Martin acoustic-electric named Joni — and I write speculative fiction. Based in Durham, NC, working across time zones.
              </p>
            </div>
          </section>

          <!-- CONTACT -->
          <section class="about-section" aria-labelledby="section-contact-title">
            <div class="about-section__header">
              <div>
                <div class="about-section__eyebrow cg-eyebrow">Work with me</div>
                <h2 id="section-contact-title" class="about-section__title">How we might work together</h2>
              </div>
            </div>
            <div class="ab-cta-panel">
              <div class="ab-cta-panel__headline">Currently open to</div>
              <p class="ab-cta-panel__body">
                Security and infrastructure consulting for small teams, narrative and content strategy for developer tools, and collaborations with organizations whose systems touch vulnerable communities or sensitive data.
              </p>

              <div class="ab-engagement-grid">
                <div class="ab-engagement-card">
                  <div class="ab-engagement-card__label">Security Architecture Sprint</div>
                  <p class="ab-engagement-card__detail">2–6 weeks. Threat modeling, control design, and incident runbooks for one critical system. Best for: small teams pre-SOC2, post-incident, or building something that touches sensitive identity or health data.</p>
                </div>
                <div class="ab-engagement-card">
                  <div class="ab-engagement-card__label">Narrative + Documentation</div>
                  <p class="ab-engagement-card__detail">Ongoing or project-based. Positioning, technical docs, and security pages that reflect how your system actually behaves. Best for: infra and security products whose copy has drifted from their architecture.</p>
                </div>
                <div class="ab-engagement-card">
                  <div class="ab-engagement-card__label">Ongoing Advisory</div>
                  <p class="ab-engagement-card__detail">Quarterly or monthly. Infra review, content audit, and AI governance check-in with an explicit human-risk lens. Best for: orgs that need a security + narrative voice without a full-time hire.</p>
                </div>
              </div>

              {/* The primary CTA repeats here so the page closes on the same
                  action the hero opens with — a reader who scrolled the whole
                  page should not have to scroll back up to act on it. */}
              <div class="ab-cta-panel__action">
                <a class="ab-button-primary" href="/contact/">
                  <span class="ab-dot"></span>
                  Start a security engagement
                </a>
              </div>

              <div class="ab-cta-panel__channels">
                <a class="ab-cta-pill" href="/work/">
                  <span class="ab-cta-pill__dot" aria-hidden="true"></span>
                  View selected work
                </a>
                <a class="ab-cta-pill" href="/mazze-leczzare-cv.pdf">
                  <span class="ab-cta-pill__dot" aria-hidden="true"></span>
                  Download CV (PDF)
                </a>
                <a class="ab-cta-pill" href={SITE_EMAIL}>
                  <span class="ab-cta-pill__dot" aria-hidden="true"></span>
                  Security inquiries — {securityEmail}
                </a>
                <a class="ab-cta-pill" href="https://github.com/mazze93" target="_blank" rel="noreferrer">
                  <span class="ab-cta-pill__dot" aria-hidden="true"></span>
                  GitHub
                </a>
                <a class="ab-cta-pill" href="https://linkedin.com/in/mazze-leczzare" target="_blank" rel="noreferrer">
                  <span class="ab-cta-pill__dot" aria-hidden="true"></span>
                  LinkedIn
                </a>
              </div>
            </div>
          </section>

        </main>
        <p class="about-footer-note">
          This site runs on <a href="/cipher-gothic/">Cipher Gothic →</a> — a design language for systems made intimate.
        </p>
      </div>
    </div>

    <Footer />
  </body>
</html>

<style>
  /* ── About page — Cipher Gothic tokens ────────────────────────────────
     No bespoke palette or typefaces: this page consumes the same
     --teal / --coral / --font-display / --font-mono system as /work,
     /project/[slug], and the rest of the editorial surface. ── */
  .about-page {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    -webkit-font-smoothing: antialiased;
    min-height: 60vh;
  }

  .about-shell {
    width: 100%;
    max-width: 1040px;
    margin: 0 auto;
    padding: 24px 24px 64px;
  }

  .about-main {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* ── Hero ── */
  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 28px;
    align-items: flex-start;
    padding: 24px 20px;
    border-radius: 24px;
    background:
      linear-gradient(145deg, rgba(var(--accent-rgb), 0.05), var(--surface)),
      radial-gradient(circle at 0 0, rgba(var(--accent-rgb), 0.14), transparent 55%);
    border: 1px solid rgba(var(--accent-rgb), 0.16);
    box-shadow: var(--shadow-md);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .about-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 0 0, rgba(var(--accent-rgb), 0.1), transparent 55%),
      linear-gradient(120deg, rgba(var(--accent-rgb), 0.04) 0, transparent 40%),
      repeating-linear-gradient(
        to right,
        var(--rule),
        var(--rule) 0.5px,
        transparent 1px,
        transparent 9px
      );
    mask-image: radial-gradient(circle at 10% 0, rgba(0, 0, 0, 0.6), transparent 70%);
    opacity: 0.7;
    pointer-events: none;
    z-index: -1;
  }

  .about-hero__title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.4vw, 2.6rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
    margin: 0 0 12px;
    color: var(--text);
  }

  /* The line directly under the h1 — carries the hook the headline drops, so
     it sits closer to title weight than to body copy. */
  .about-hero__lede {
    max-width: 34rem;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--text);
    margin-bottom: 18px;
  }

  .about-hero__subtitle {
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-dim);
    margin-bottom: 16px;
  }

  .about-hero__subtitle strong { color: var(--text); font-weight: 500; }

  .about-hero__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--text-dim);
    line-height: 1.8;
    max-width: 30rem;
  }

  .about-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .about-hero__meta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-end;
    justify-content: space-between;
  }

  .about-hero__meta-top {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .about-hero__meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-end;
    margin-top: 6px;
  }

  .about-hero__cta-group {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    margin-top: 12px;
  }

  .ab-meta-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--text-faint);
  }

  .ab-meta-value {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text);
  }

  /* ── Tag pills ── */
  .ab-tag-pill {
    border-radius: 999px;
    border: 1px solid var(--rule);
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-dim);
    background: var(--surface);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .ab-tag-pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--teal);
    flex-shrink: 0;
  }

  /* ── Buttons ── */
  .ab-button-primary,
  .ab-button-ghost {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    border-radius: 999px;
    padding: 8px 16px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 8px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: opacity var(--transition-fast), border-color var(--transition-fast);
  }

  .ab-button-primary:hover,
  .ab-button-ghost:hover { opacity: 0.85; }

  /* Format hint on the CV link — the label says "Download", so say what lands. */
  .ab-button-ghost__meta {
    margin-left: 0.5ch;
    font-size: 0.68rem;
    letter-spacing: var(--cg-tracking-wide, 0.05em);
    color: var(--text-faint);
  }

  .ab-button-primary:focus-visible,
  .ab-button-ghost:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 3px;
  }

  .ab-button-primary {
    background: rgba(var(--accent-rgb), 0.14);
    border-color: var(--teal);
    color: var(--text);
  }

  .ab-button-ghost {
    border-color: var(--rule);
    color: var(--text-dim);
    background: var(--surface);
  }

  .ab-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  /* ── Sections ── */
  .about-section {
    padding: 16px 4px 0;
    border-top: 1px solid var(--rule);
    margin-top: 12px;
  }

  .about-section__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  /* Font/size/tracking/color come from .cg-eyebrow (global.css) —
     consolidated onto the shared design-system mixin; this rule only
     owns page-specific layout. */
  .about-section__eyebrow {
    margin-bottom: 4px;
  }

  .about-section__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--text);
    margin: 0;
  }

  .about-section__hint {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    margin: 0;
  }

  /* Underlined so inline links don't rely on color alone to read as links. */
  .about-section__hint a {
    text-decoration: underline;
    text-decoration-color: rgba(var(--accent-rgb), 0.5);
    text-underline-offset: 2px;
  }

  /* ── Grid ── */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 24px;
  }

  .about-grid__side {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ── Work cards ── */
  .ab-work-card {
    border-radius: var(--radius-md);
    background:
      radial-gradient(circle at 0 0, rgba(var(--accent-rgb), 0.09), transparent 55%),
      var(--surface);
    border: 1px solid var(--rule);
    padding: 18px 18px 16px;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .ab-work-card--secondary {
    background: var(--surface);
    background-image: none;
  }

  /* __title-row, __badge, __badge--accent, __list removed with the status
     badges and bullet lists they styled — the cards are one sentence now. */
  .ab-work-card__title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--text);
    margin: 0 0 8px;
  }

  .ab-work-card__body {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.75;
    color: var(--text-dim);
    margin-bottom: 10px;
    margin-top: 0;
  }

  .ab-work-card__cta {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .ab-work-card__cta a {
    color: var(--teal);
    text-decoration: none;
  }

  .ab-work-card__cta a:hover { text-decoration: underline; }

  .ab-work-card__cta a:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* ── Narrative blocks ── */
  .ab-narrative-block {
    border-radius: var(--radius-md);
    padding: 18px 18px 16px;
    border: 1px solid var(--rule);
    background:
      radial-gradient(circle at 0 0, rgba(var(--accent-rgb), 0.06), transparent 55%),
      var(--surface);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.8;
    color: var(--text-dim);
    height: 100%;
    box-sizing: border-box;
  }

  .ab-narrative-block p { margin: 0 0 10px; }
  .ab-narrative-block p:last-child { margin-bottom: 0; }

  .ab-narrative-block--serif {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  /* ── Background list ── */
  .ab-background-list {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--text-dim);
  }

  .ab-background-list p { margin: 0 0 8px; }

  /* Underlined so inline links don't rely on color alone to read as links. */
  .ab-background-list a {
    text-decoration: underline;
    text-decoration-color: rgba(var(--accent-rgb), 0.5);
    text-underline-offset: 2px;
  }
  .ab-background-list em { color: var(--text); font-style: italic; }

  /* ── CTA panel ── */
  .ab-cta-panel {
    border-radius: var(--radius-md);
    padding: 18px 20px 16px;
    border: 1px solid var(--rule);
    background:
      radial-gradient(circle at 0 0, rgba(var(--accent-rgb), 0.06), transparent 60%),
      var(--surface);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-dim);
  }

  .ab-cta-panel__headline {
    font-family: var(--font-mono);
