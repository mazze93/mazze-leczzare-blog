---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_STORE_URL } from '../consts';

// A deliberately short landing page. The storefront itself lives at
// store.mazzeleczzare.com; this exists so the store is reachable from the
// main site's navigation and has a sentence of context before you leave.
const shelves = [
  {
    name: 'Verification & discipline',
    line: 'Skills that make an agent prove a claim instead of asserting it — touchstone, corroborate, concurrency-probe, claude-md-audit.',
  },
  {
    name: 'Fleet operations',
    line: 'Cloudflare, Workers, and workspace tooling packaged as plugins — wrangler, cloudflare-one, workspace-sync, disk-audit.',
  },
  {
    name: 'Continuity',
    line: 'Keeping long autonomous sessions recoverable — engram, session-journal, transcript-handoff, stratum-project-init.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Store | ${SITE_TITLE}`}
      description="A storefront for Claude Code plugins and skills — verification discipline, fleet operations, and continuity for long autonomous sessions."
    />
  </head>
  <body>
    <Header />
    <main>
      <section class="store-shell">
        <div class="store-intro">
          <p class="eyebrow">Store</p>
          <h1>Tools I use, packaged to install</h1>
          <p class="lede">
            <a href={SITE_STORE_URL} target="_blank" rel="noopener noreferrer">store.mazzeleczzare.com</a>
            carries the Claude Code plugins and skills built while doing the work described elsewhere on
            this site — the verification harnesses, the fleet scripts, the session-continuity system.
            Six plugins, twenty-three skills, all open source. This page is just the door.
          </p>
        </div>

        <ul class="shelf-list" role="list">
          {shelves.map((s) => (
            <li class="shelf">
              <span class="shelf-name">{s.name}</span>
              <span class="shelf-line">{s.line}</span>
            </li>
          ))}
        </ul>

        <a class="store-cta" href={SITE_STORE_URL} target="_blank" rel="noopener noreferrer">
          Browse the store
          <span aria-hidden="true">→</span>
          <span class="sr-only">(opens store.mazzeleczzare.com in a new tab)</span>
        </a>

        <p class="store-aside">
          Looking for the book? <em>Gay Wandering — Reader No. 01</em> is a separate release —
          it lives on <a href="/gay-wandering/">its own page</a>, not in the store.
        </p>
      </section>
    </main>
    <Footer />

    <style>
      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 4em 1.5em 6em;
      }

      .eyebrow {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--text-dim);
        margin: 0 0 1em;
      }

      h1 {
        font-family: var(--font-display);
        font-size: clamp(1.9rem, 4vw, 2.6rem);
        font-weight: 500;
        line-height: 1.15;
        color: var(--text);
        margin: 0 0 0.6em;
      }

      .lede {
        font-family: var(--font-sans);
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--text-dim);
        margin: 0;
      }

      .lede a,
      .store-aside a {
        color: var(--teal);
        text-decoration: none;
      }

      .lede a:hover,
      .store-aside a:hover {
        text-decoration: underline;
      }

      .shelf-list {
        list-style: none;
        margin: 2.75em 0 0;
        padding: 0;
        display: grid;
        gap: 1px;
        background: var(--rule);
        border: 1px solid var(--rule);
        border-radius: var(--radius-sm);
        overflow: hidden;
      }

      .shelf {
        background: var(--surface);
        padding: 1.15em 1.25em;
        display: grid;
        gap: 0.35em;
      }

      .shelf-name {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--teal);
      }

      .shelf-line {
        font-family: var(--font-sans);
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--text-dim);
      }

      .store-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        margin-top: 2.5em;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text);
        text-decoration: none;
        padding: 0.7em 1.1em;
        border: 1px solid var(--rule);
        border-radius: var(--radius-sm);
        transition: color var(--transition-fast), border-color var(--transition-fast);
      }

      .store-cta:hover {
        color: var(--teal);
        border-color: rgba(var(--accent-rgb), 0.3);
      }

      .store-cta:focus-visible {
        outline: 2px solid var(--teal);
        outline-offset: 2px;
      }

      .store-aside {
        margin-top: 3em;
        padding-top: 1.5em;
        border-top: 1px solid var(--rule);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        line-height: 1.7;
        color: var(--text-faint);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
      }
    </style>
  </body>
</html>
