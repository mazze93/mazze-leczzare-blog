---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sorted = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const published = sorted.filter(p => !p.data.draft);
const drafts    = sorted.filter(p =>  p.data.draft);

// ── Writing cadence ──────────────────────────────────────────────────────────
const daysSinceLast = published.length > 0
  ? Math.floor((Date.now() - published[0].data.pubDate.valueOf()) / 86_400_000)
  : null;

// ── Tag taxonomy ─────────────────────────────────────────────────────────────
const tagCounts: Record<string, number> = {};
for (const post of published) {
  for (const tag of post.data.tags ?? []) {
    tagCounts[tag] = (tagCounts[tag] ?? 0) + 1;
  }
}
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);

// ── Content health ───────────────────────────────────────────────────────────
type Gap = 'tags' | 'hero' | 'category';
const GAP_LABEL: Record<Gap, string> = {
  tags:     'no tags',
  hero:     'no hero image',
  category: 'no category',
};
const needsAttention = published
  .map(post => {
    const gaps: Gap[] = [];
    if (!post.data.tags || post.data.tags.length === 0) gaps.push('tags');
    if (!post.data.heroImage) gaps.push('hero');
    if (!post.data.category)  gaps.push('category');
    return { post, gaps };
  })
  .filter(({ gaps }) => gaps.length > 0);

// ── Corpus entropy ────────────────────────────────────────────────────────────
// Shannon entropy H = −∑ p(w)·log₂p(w) over the word-unigram distribution.
// Measures lexical diversity: how unpredictable your vocabulary is across the
// whole published corpus. High entropy = rich, varied signal.
const wordFreq: Record<string, number> = {};
let totalWords = 0;
for (const post of published) {
  const body = ('body' in post ? post.body as string : '') ?? '';
  const words = body.toLowerCase().replace(/[^a-z\s]/g, ' ').split(/\s+/).filter(Boolean);
  for (const word of words) {
    wordFreq[word] = (wordFreq[word] ?? 0) + 1;
    totalWords++;
  }
}
let entropy = 0;
if (totalWords > 0) {
  for (const count of Object.values(wordFreq)) {
    const p = count / totalWords;
    entropy -= p * Math.log2(p);
  }
}
const entropyBits   = totalWords > 0 ? entropy.toFixed(2) : '—';
const uniqueWordCount = Object.keys(wordFreq).length;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Admin | ${SITE_TITLE}`}
      description="Admin dashboard"
    />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <Header />
    <main>
      <section class="admin-shell">
        <div class="admin-header">
          <div>
            <p class="eyebrow">Admin</p>
            <h1>Dashboard</h1>
          </div>
          <button id="logout-btn" class="logout-btn">Sign out</button>
        </div>

        <div class="admin-content">

          <!-- Stats row -->
          <div class="stat-grid">
            <div class="stat-card">
              <span class="stat-value">{published.length}</span>
              <span class="stat-label">Published</span>
            </div>
            <div class="stat-card">
              <span class="stat-value">{drafts.length}</span>
              <span class="stat-label">Drafts</span>
            </div>
            {daysSinceLast !== null && (
              <div class="stat-card">
                <span class="stat-value">{daysSinceLast}</span>
                <span class="stat-label">{daysSinceLast === 1 ? 'day since last post' : 'days since last post'}</span>
              </div>
            )}
            <div class="stat-card stat-card--entropy" title="Shannon entropy of word-unigram distribution across all published posts">
              <span class="stat-value stat-value--entropy">
                {entropyBits}{totalWords > 0 && <span class="entropy-unit">bits</span>}
              </span>
              <span class="stat-label">corpus entropy</span>
              {uniqueWordCount > 0 && (
                <span class="stat-sub">{uniqueWordCount.toLocaleString()} unique words</span>
              )}
            </div>
          </div>

          <!-- Posts -->
          <div class="panel">
            <h2>Posts</h2>
            <ul class="posts-list">
              {sorted.map((post) => (
                <li class="post-row">
                  {post.data.draft ? (
                    <span class="post-title post-title--draft">{post.data.title}</span>
                  ) : (
                    <a href={`/blog/${post.id}`} class="post-title">{post.data.title}</a>
                  )}
                  <div class="post-meta">
                    {post.data.draft && <span class="badge badge--draft">Draft</span>}
                    <span class="post-date">
                      {post.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tag taxonomy -->
          {tags.length > 0 && (
            <div class="panel">
              <h2>Tags</h2>
              <div class="tag-cloud">
                {tags.map(([tag, count]) => (
                  <span class="tag-pill">
                    {tag}<span class="tag-count">×{count}</span>
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Content health -->
          {needsAttention.length > 0 && (
            <div class="panel panel--health">
              <h2>Content gaps</h2>
              <p class="health-intro">
                {needsAttention.length === 1
                  ? '1 published post has missing metadata.'
                  : `${needsAttention.length} published posts have missing metadata.`}
              </p>
              <ul class="health-list">
                {needsAttention.map(({ post, gaps }) => (
                  <li class="health-row">
                    <a href={`/blog/${post.id}`} class="health-title">{post.data.title}</a>
                    <span class="health-gaps">
                      {gaps.map(g => GAP_LABEL[g]).join(' · ')}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}

        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<script>
  const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement;

  logoutBtn.addEventListener('click', async () => {
    logoutBtn.disabled = true;
    logoutBtn.textContent = 'Signing out…';
    await fetch('/api/logout', { method: 'POST' });
    window.location.href = '/';
  });
</script>

<style>
  main {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
  }

  .admin-shell {
    min-height: calc(100vh - 68px);
    padding: 3rem 1.25rem 5rem;
    background:
      radial-gradient(circle at top left, rgba(var(--accent-rgb), 0.08), transparent 24%),
      linear-gradient(165deg, rgba(9, 12, 20, 0.98), rgba(12, 28, 34, 0.96));
  }

  .admin-header {
    width: min(860px, 100%);
    margin: 0 auto 2rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .admin-content {
    width: min(860px, 100%);
    margin: 0 auto;
    display: grid;
    gap: 2rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: #f79a6d;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.9rem;
    font-weight: 500;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
    color: #f5f1e8;
  }

  .logout-btn {
    border: 1px solid rgba(135, 148, 171, 0.3);
    border-radius: 999px;
    padding: 0.6rem 1.25rem;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    color: rgba(245, 241, 232, 0.8);
    background: rgba(99, 110, 116, 0.3);
    cursor: pointer;
    transition: border-color var(--transition-fast), background var(--transition-fast), color var(--transition-fast);
    white-space: nowrap;
  }

  .logout-btn:hover {
    border-color: rgba(247, 154, 109, 0.5);
    color: #f79a6d;
    background: rgba(247, 154, 109, 0.08);
  }

  .logout-btn:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  /* ── Stat grid ─────────────────────────────────────────────────────────── */

  .stat-grid {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .stat-card {
    padding: 1.5rem 2rem;
    border-radius: 20px;
    border: 1px solid rgba(135, 148, 171, 0.18);
    background: rgba(99, 110, 116, 0.4);
    backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 9rem;
  }

  .stat-card--entropy {
    border-color: rgba(94, 196, 210, 0.22);
    background: rgba(30, 70, 82, 0.45);
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 500;
    color: #f5f1e8;
    line-height: 1;
  }

  .stat-value--entropy {
    font-family: 'DM Mono', 'Courier New', monospace;
    color: #7dd3e8;
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .entropy-unit {
    font-size: 1rem;
    font-weight: 400;
    color: rgba(125, 211, 232, 0.6);
    letter-spacing: 0.04em;
  }

  .stat-label {
    font-size: 0.85rem;
    color: rgba(245, 241, 232, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .stat-sub {
    font-size: 0.78rem;
    color: rgba(125, 211, 232, 0.5);
    margin-top: 0.1rem;
    font-family: 'DM Mono', monospace;
  }

  /* ── Shared panel ──────────────────────────────────────────────────────── */

  .panel {
    padding: 1.75rem 2rem;
    border-radius: 24px;
    border: 1px solid rgba(135, 148, 171, 0.18);
    background: rgba(99, 110, 116, 0.4);
    backdrop-filter: blur(12px);
  }

  .panel--health {
    border-color: rgba(251, 191, 36, 0.2);
    background: rgba(80, 60, 20, 0.35);
  }

  h2 {
    margin: 0 0 1.25rem;
    color: #f5f1e8;
    font-size: 1.1rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ── Posts list ────────────────────────────────────────────────────────── */

  .posts-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }

  .post-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    transition: background var(--transition-fast);
  }

  .post-row:hover {
    background: rgba(135, 148, 171, 0.12);
  }

  .post-title {
    color: #f5f1e8;
    text-decoration: none;
    font-weight: 500;
    font-size: 1rem;
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-title:hover {
    color: #f79a6d;
  }

  .post-title--draft {
    opacity: 0.45;
    cursor: default;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .post-date {
    font-size: 0.85rem;
    color: rgba(245, 241, 232, 0.5);
    white-space: nowrap;
  }

  .badge {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
  }

  .badge--draft {
    background: rgba(247, 154, 109, 0.15);
    color: #f79a6d;
    border: 1px solid rgba(247, 154, 109, 0.3);
  }

  /* ── Tag cloud ─────────────────────────────────────────────────────────── */

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(135, 148, 171, 0.25);
    background: rgba(135, 148, 171, 0.1);
    color: rgba(245, 241, 232, 0.8);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .tag-count {
    font-size: 0.75rem;
    color: rgba(247, 154, 109, 0.75);
    font-weight: 500;
  }

  /* ── Content health ────────────────────────────────────────────────────── */

  .health-intro {
    margin: -0.5rem 0 1rem;
    font-size: 0.9rem;
    color: rgba(251, 191, 36, 0.7);
  }

  .health-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .health-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 1rem;
    border-radius: 10px;
    transition: background var(--transition-fast);
  }

  .health-row:hover {
    background: rgba(251, 191, 36, 0.06);
  }

  .health-title {
    color: #f5f1e8;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .health-title:hover {
    color: #fbbf24;
  }

  .health-gaps {
    font-size: 0.8rem;
    color: rgba(251, 191, 36, 0.6);
    white-space: nowrap;
    flex-shrink: 0;
    font-family: 'DM Mono', monospace;
  }

  /* ── Responsive ────────────────────────────────────────────────────────── */

  @media (max-width: 720px) {
    .admin-shell {
      padding: 2rem 1rem 4rem;
    }

    .panel {
      padding: 1.25rem 1rem;
    }

    .stat-card {
      padding: 1.25rem 1.5rem;
    }
  }
</style>
