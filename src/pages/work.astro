---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FieldFigure from '../components/work/FieldFigure';
import TierChip from '../components/work/TierChip.astro';
import WorkEntry from '../components/work/WorkEntry.astro';
import { SITE_TITLE } from '../consts';
import { HARDENING_SPRINT, formatUsd } from '../data/services';
import { groupWork } from '../data/work';

/**
 * /work — the publication surface.
 *
 * Ported from the standalone Publication Surface plate (v1.2.3). Entries live
 * one per file in `src/content/work/<slug>.json`; the model, tiers, and
 * sections are defined in `src/data/work.ts`, and each row renders through
 * `components/work/WorkEntry`. Visual weight tracks evidence strength on
 * purpose — `live` is teal and loud, `self` is faint. Nothing here promotes
 * itself above what backs it.
 */

const sections = groupWork(await getCollection('work'));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Work — ${SITE_TITLE}`}
      description="Selected research, security engineering, and systems work from Mazze LeCzzare. Every claim on this page carries its evidence tier."
    />
  </head>
  <body>
    <Header />
    <main>

      <!-- Page header -->
      <div class="work-header">
        <FieldFigure client:visible />
        <p class="section-eyebrow">Work</p>
        <h1 class="page-title">I build systems that cannot conceal their own state.</h1>
        <p class="page-desc">
          Agentic systems fail by a single move: a generated claim becomes operational truth merely because it was persisted or repeated. My work refuses that move at every layer I can reach — runtime, build process, memory, prose. The full archive lives in <a href="/writing/">Writing</a> and <a href="/studio/">Studio</a>.
        </p>
        <p class="page-desc page-desc--adjacent">
          Need this applied to your repository? <a href={HARDENING_SPRINT.path}>{HARDENING_SPRINT.name} — {formatUsd(HARDENING_SPRINT.priceUsd)}</a>, with reviewed changes and a documented handoff.
        </p>
        <p class="page-desc page-desc--adjacent">
          For the research-operations record behind this — lab operations, training programs, and scientific communication — see <a href="/work/research-program-operations/">Research Program Operations</a>.
        </p>
      </div>

      <!-- Reading protocol — the tier legend -->
      <section class="protocol" aria-labelledby="protocol-label">
        <h2 class="section-label" id="protocol-label"><span>Reading protocol</span></h2>
        <p class="protocol-lede">
          This page tiers its own claims. <em>Nothing here promotes itself above its evidence</em> — the same contract my systems enforce, applied to the person describing them. Weaker evidence is rendered quieter on purpose.
        </p>
        <ul class="tier-key" role="list">
          <li>
            <TierChip tier="live" />
            <span class="tier-desc">Deployed and running. Don&rsquo;t take my word — click it.</span>
          </li>
          <li>
            <TierChip tier="published" />
            <span class="tier-desc">In the permanent record under my name.</span>
          </li>
          <li>
            <TierChip tier="acknowledged" />
            <span class="tier-desc">Named in <em>someone else&rsquo;s</em> record. I state my role exactly; I claim nothing past it.</span>
          </li>
          <li>
            <TierChip tier="self" />
            <span class="tier-desc">My word, held to account. References available on request.</span>
          </li>
        </ul>
      </section>

      {sections.map((section) => (
        <section class="work-section" aria-labelledby={`${section.id}-label`}>
          <h2 class="section-label" id={`${section.id}-label`}>
            <span class="section-rn">{section.rn}</span>
            <span>{section.label}</span>
          </h2>

          <div class="work-grid">
            {section.entries.map((e) => (
              <WorkEntry entry={e.data} />
            ))}
          </div>
        </section>
      ))}

      <!-- Present bearing — the current research line -->
      <aside class="bearing" aria-label="Present bearing">
        <p class="bearing-label">Present bearing</p>
        <p>
          Current research line: <em>the epistemic integrity of agentic systems under adversarial context.</em> When an AI system&rsquo;s context is reshaped against it, does it surface the fault — or reclassify the fault as correct and defend it? The ledger is the instrument, the fault-injection method is the probe, and the counterfeit program is the precedent: adversarial artifacts, measured detectors, and the gap between them.
        </p>
        <p>
          The instrument doesn&rsquo;t know the destination. A navigator reads the instrument. <em>A human decides where to sail.</em>
        </p>
      </aside>

      <!-- Closing wayfinding -->
      <nav class="work-wayfinding" aria-label="More ways to explore this work">
        <a class="wayfind-link" href="/writing/">
          <span class="wayfind-title">The catalogue</span>
          <span class="wayfind-desc">Everything published, one entry each</span>
        </a>
        <a class="wayfind-link" href="/studio/">
          <span class="wayfind-title">The bench</span>
          <span class="wayfind-desc">Every project, by recency and decay</span>
        </a>
        <a class="wayfind-link" href="/about/">
          <span class="wayfind-title">About</span>
          <span class="wayfind-desc">How this all fits together</span>
        </a>
      </nav>

    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 900px;
    width: calc(100% - 2rem);
    margin: 0 auto;
    padding: 0 1rem 6rem;
  }

  /* ── Page header ── */
  .work-header {
    position: relative;
    padding: 4em 0 3em;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 0;
  }

  /* The field plate is full-bleed behind the header — it reads as a printed
     sheet the text sits on, not as a box the text sits beside. It escapes
     main's 900px measure without changing the flow of anything in it. */
  .work-header :global(.plate-bleed) {
    position: absolute;
    inset: 0 calc(50% - 50vw);
  }

  .work-header > :not(:global(.plate-bleed)) {
    position: relative;
    z-index: 1;
  }

  .section-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68em;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.75em;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 5.6vw, 3.8rem);
    font-weight: 300;
    color: var(--text);
    margin: 0 0 0.5em;
    line-height: 1.08;
    max-width: 20ch;
  }

  .page-desc {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--text-dim);
    margin: 0;
    max-width: 58ch;
    line-height: 1.75;
  }

  .page-desc a { color: var(--teal); }

  /* Pointer to the adjacent research-operations dossier. Set quieter than the
     lede above it — it is a cross-reference, not a second thesis. */
  .page-desc--adjacent {
    margin-top: 1.25em;
    font-size: 0.78em;
    color: var(--text-faint);
  }

  /* ── Reading protocol ── */
  .protocol {
    padding: 3rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .protocol-lede {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.75;
    color: var(--text-dim);
    max-width: 62ch;
    margin: 0 0 1.75rem;
  }
  .protocol-lede em { color: var(--text); font-style: normal; font-weight: 500; }

  .tier-key {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
    gap: 1rem 2rem;
  }

  .tier-key li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .tier-desc {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--text-dim);
  }
  .tier-desc em { color: var(--text); font-style: italic; }

  /* ── Section wrapper ── */
  .work-section {
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--teal);
    margin: 0 0 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }
  .section-rn { color: var(--coral); }

  /* ── Entries — two-column ledger rows; see components/work/WorkEntry ── */
  .work-grid {
    display: flex;
    flex-direction: column;
  }


  /* ── Present bearing ── */
  .bearing {
    position: relative;
    margin-top: 3.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--surface);
    padding: 2.5rem 2.4rem 2.2rem;
  }

  .bearing-label {
    position: absolute;
    top: -0.62em;
    left: 2rem;
    background: var(--bg);
    padding-inline: 0.6em;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--coral);
  }

  .bearing p:not(.bearing-label) {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.8;
    color: var(--text-dim);
    max-width: 66ch;
    margin: 0 0 0.9rem;
  }
  .bearing p:last-child { margin-bottom: 0; }
  .bearing em { color: var(--text); font-style: italic; }

  /* ── Closing wayfinding ── */
  .work-wayfinding {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding-top: 3rem;
  }

  .wayfind-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 1.3rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .wayfind-link:hover,
  .wayfind-link:focus-visible {
    border-color: rgba(var(--accent-rgb), 0.35);
    background: rgba(var(--accent-rgb), 0.04);
  }

  .wayfind-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--text);
  }
  .wayfind-link:hover .wayfind-title { color: var(--teal); }

  .wayfind-desc {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
    line-height: 1.5;
  }

  /* ── Responsive ── */
  @media (max-width: 760px) {
    .work-wayfinding { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .bearing { padding: 2.2rem 1.4rem 1.8rem; }
    .bearing-label { left: 1.2rem; }
  }
</style>
