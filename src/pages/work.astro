---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FieldFigure from '../components/work/FieldFigure';
import { SITE_TITLE } from '../consts';

interface Piece {
  label: string;
  title: string;
  href: string;
  external?: boolean;
}

interface ProjectCard {
  slug: string;
  flagship?: boolean;
  eyebrow: string;
  title: string;
  subtitle?: string;
  status: string;
  thesis: string;
  pieces: Piece[];
  projectHref?: string;
}

const research: ProjectCard[] = [
  {
    slug: 'intentional-fragility',
    flagship: true,
    eyebrow: 'Spine project',
    title: 'Intentional Fragility',
    status: 'Formal paper · two live instruments · essays',
    thesis:
      'A system should be built to break in the right places — the break is the record, not the failure. Context should cost something to keep; protection should be earned, not granted. One idea, instantiated across essays, a formal paper, and two live instruments in AI security.',
    pieces: [
      { label: 'Spine', title: 'Read the standing statement', href: '/intentional-fragility/' },
      { label: 'Paper', title: 'Accountable Forgetting in Local-First AI (PDF)', href: '/papers/intentional-fragility.pdf' },
      { label: 'Instruments', title: 'Kintsugi circuit breaker + a Physarum routing solver, live', href: 'https://fieldnotes.mazzeleczzare.com/mz/intentional-fragility/', external: true },
      { label: 'Essay', title: 'The Lighthouse Earns Its Floor', href: '/blog/the-lighthouse-earns-its-floor/' },
    ],
    projectHref: '/project/intentional-fragility/',
  },
  {
    slug: 'cognitive-topology',
    eyebrow: 'Essay · April 2026',
    title: 'The Concept Is Not the State',
    subtitle: 'What Anthropic’s emotion paper actually found',
    status: 'Interpretability · constructionism · alignment',
    thesis:
      'Anthropic’s interpretability team showed emotion concepts are causally operative in Claude’s behavior. That is not the same as showing Claude has emotions. A constructionist critique, written from a background in affective neuroscience — representational similarity analysis, the Barrett lab’s framework — applied to a live alignment question.',
    pieces: [
      { label: 'Essay', title: 'Read the full piece', href: '/blog/concept-is-not-the-state/' },
    ],
    projectHref: '/project/cognitive-topology/',
  },
  {
    slug: 'banknote-authentication',
    eyebrow: 'UC Davis · Luck Lab · 2020',
    title: 'Counterfeit Banknote Authentication Program',
    status: 'Bank of Canada · Bank of England · RBA · US Fed',
    thesis:
      'Selected by Dr. Steven J. Luck to run experimental data collection for a multi-country banknote-authentication program — eye-tracking, EEG/ERP, and behavioral testing against real forensically recovered counterfeit currency, with consented community volunteers. The direct methodological ancestor of Intentional Fragility: measuring, against real adversarial artifacts, where a security feature actually holds and where it fails.',
    pieces: [
      { label: 'Paper', title: 'Dodgson & Raymond — Banknote authenticity is signalled by rapid neural responses, Scientific Reports 12:2076 (2022)', href: 'https://www.nature.com/articles/s41598-022-05972-8', external: true },
    ],
  },
];

const systems: ProjectCard[] = [
  {
    slug: 'secure-pride',
    eyebrow: 'Nonprofit · active',
    title: 'Secure Pride',
    status: 'Certificate auth · hardening · playbooks',
    thesis:
      'LGBTQ+ clinics, mutual aid orgs, and health services handle identity and health data with real consequences and rarely have dedicated IT. Secure Pride designs certificate-based network authentication, hardens the workstations and cloud services that touch that data, and writes security playbooks non-technical staff can actually follow.',
    pieces: [
      { label: 'Site', title: 'securepride.org', href: 'https://securepride.org', external: true },
      { label: 'Essay', title: 'From Erasure to Signal: Building Secure Pride', href: '/blog/secure-pride-origin/' },
    ],
    projectHref: '/project/secure-pride/',
  },
  {
    slug: 'context-synapse',
    eyebrow: 'Research · Swift, local-only',
    title: 'Context Synapse',
    status: 'Bayesian modeling · on-device · no exfiltration',
    thesis:
      'A local-first context-orchestration framework: probabilistic modeling of what a system has learned about you over time, entirely on-device, with interfaces for interrogating and correcting what it thinks it knows. Research project and privacy commitment, written into the same codebase.',
    pieces: [
      { label: 'Essay', title: 'On Decay, Rot, and the Goblin at the Gate', href: '/blog/on-decay-rot-and-the-goblin-at-the-gate/' },
    ],
    projectHref: '/project/context-synapse/',
  },
];

const instruments = [
  { title: 'Stratum', desc: 'Epistemic decision ledger — provenance, not persuasion. The live demo replays its own construction.', href: 'https://stratum.mazzeleczzare.com' },
  { title: 'Stele', desc: 'The directive compiler. Memory is the model’s; the directive is yours.', href: 'https://stele.mazzeleczzare.com' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Work — ${SITE_TITLE}`}
      description="Selected research, security engineering, and systems work from Mazze LeCzzare — Intentional Fragility, Secure Pride, Context Synapse, and the writing that explains each."
    />
  </head>
  <body>
    <Header />
    <main>

      <!-- Page header -->
      <div class="work-header">
        <FieldFigure client:visible />
        <p class="section-eyebrow">Work</p>
        <h1 class="page-title">Research, systems, and the writing that explains both.</h1>
        <p class="page-desc">
          Selected projects, organized around one throughline: what a system knows, what it's allowed to forget, and who pays when it gets that wrong. This is the case for the work — the full archive lives in <a href="/writing/">Writing</a> and <a href="/studio/">Studio</a>.
        </p>
      </div>

      <!-- 01 — Research -->
      <section class="work-section" aria-labelledby="research-label">
        <h2 class="section-label" id="research-label"><span>01 — Research</span></h2>

        <div class="work-grid">
          {research.map((p) => (
            <article class={`work-card ${p.flagship ? 'work-card--flagship' : ''}`}>
              <div class="card-top">
                <span class={`tag ${p.flagship ? 'tag--gold' : 'tag--teal'}`}>{p.eyebrow}</span>
                <span class="card-status">{p.status}</span>
              </div>
              <h3 class="card-title">{p.title}</h3>
              {p.subtitle && <p class="card-subtitle">{p.subtitle}</p>}
              <p class="card-thesis">{p.thesis}</p>

              <ul class="card-pieces" role="list">
                {p.pieces.map((piece) => (
                  <li class="card-piece">
                    <a
                      href={piece.href}
                      {...(piece.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      aria-label={piece.external ? `${piece.title} (opens in new tab)` : piece.title}
                    >
                      <span class="piece-label">{piece.label}</span>
                      <span class="piece-title">{piece.title}</span>
                    </a>
                  </li>
                ))}
              </ul>

              {p.projectHref && (
                <a class="card-link" href={p.projectHref}>
                  Full project
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
                </a>
              )}
            </article>
          ))}
        </div>
      </section>

      <!-- 02 — Systems -->
      <section class="work-section" aria-labelledby="systems-label">
        <h2 class="section-label" id="systems-label"><span>02 — Systems</span></h2>

        <div class="work-grid">
          {systems.map((p) => (
            <article class="work-card">
              <div class="card-top">
                <span class="tag tag--teal">{p.eyebrow}</span>
                <span class="card-status">{p.status}</span>
              </div>
              <h3 class="card-title">{p.title}</h3>
              <p class="card-thesis">{p.thesis}</p>

              <ul class="card-pieces" role="list">
                {p.pieces.map((piece) => (
                  <li class="card-piece">
                    <a
                      href={piece.href}
                      {...(piece.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      aria-label={piece.external ? `${piece.title} (opens in new tab)` : piece.title}
                    >
                      <span class="piece-label">{piece.label}</span>
                      <span class="piece-title">{piece.title}</span>
                    </a>
                  </li>
                ))}
              </ul>

              <a class="card-link" href={p.projectHref}>
                Full project
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
              </a>
            </article>
          ))}
        </div>

        <!-- Also running — compact instrument strip -->
        <div class="instruments">
          <h4 class="instruments-label">Also running</h4>
          <ul class="instruments-list" role="list">
            {instruments.map((inst) => (
              <li class="instrument-row">
                <a href={inst.href} target="_blank" rel="noopener noreferrer" aria-label={`${inst.title} (opens in new tab)`}>
                  <span class="instrument-title">{inst.title}</span>
                  <span class="instrument-desc">{inst.desc}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Prior chapter — de-emphasized footnote -->
      <section class="prior-chapter" aria-labelledby="prior-label">
        <h4 class="prior-label" id="prior-label">Before this</h4>
        <p class="prior-text">
          Five years leading content and production at mudstack — fifty-plus episodes of <em>Clear as Mud</em> with creators from Epic, Riot, Sony, and Meta VR, webinar production, and B2B technical writing for game-development and enterprise-communications audiences. It's where I learned to translate complex systems for people who didn't build them, which turned out to matter more here than I expected.
        </p>
      </section>

      <!-- Closing wayfinding -->
      <nav class="work-wayfinding" aria-label="More ways to explore this work">
        <a class="wayfind-link" href="/writing/">
          <span class="wayfind-title">The catalogue</span>
          <span class="wayfind-desc">Everything published, one entry each</span>
        </a>
        <a class="wayfind-link" href="/studio/">
          <span class="wayfind-title">The bench</span>
          <span class="wayfind-desc">Every project, by recency and decay</span>
        </a>
        <a class="wayfind-link" href="/about/">
          <span class="wayfind-title">About</span>
          <span class="wayfind-desc">How this all fits together</span>
        </a>
      </nav>

    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 900px;
    width: calc(100% - 2rem);
    margin: 0 auto;
    padding: 0 1rem 6rem;
  }

  /* ── Page header ── */
  .work-header {
    position: relative;
    padding: 4em 0 3em;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 0;
  }

  /* The field plate is full-bleed behind the header — it reads as a printed
     sheet the text sits on, not as a box the text sits beside. It escapes
     main's 900px measure without changing the flow of anything in it. */
  .work-header :global(.plate-bleed) {
    position: absolute;
    inset: 0 calc(50% - 50vw);
  }

  .work-header > :not(:global(.plate-bleed)) {
    position: relative;
    z-index: 1;
  }

  .section-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68em;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.75em;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 5.6vw, 3.8rem);
    font-weight: 300;
    color: var(--text);
    margin: 0 0 0.5em;
    line-height: 1.08;
    max-width: 18ch;
  }

  .page-desc {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--text-dim);
    margin: 0;
    max-width: 58ch;
    line-height: 1.75;
  }

  .page-desc a {
    color: var(--teal);
  }

  /* ── Section wrapper ── */
  .work-section {
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .work-section:last-of-type {
    border-bottom: none;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--teal);
    margin: 0 0 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  /* ── Work cards ── */
  .work-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .work-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: 2.2rem 2.4rem;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }
  .work-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(var(--accent-rgb), 0.04);
    opacity: 0;
    transition: opacity var(--transition-base);
    pointer-events: none;
  }
  .work-card:hover {
    border-color: rgba(var(--accent-rgb), 0.3);
    box-shadow: var(--shadow-md), 0 0 24px rgba(var(--accent-rgb), 0.08);
  }
  .work-card:hover::before { opacity: 1; }

  /* The spine, literally — a gold rule marks the flagship project. */
  .work-card--flagship {
    border-left: 2px solid var(--gold);
  }
  .work-card--flagship:hover {
    border-color: var(--gold);
    border-left-color: var(--gold);
    box-shadow: var(--shadow-md), 0 0 28px rgba(var(--gold-rgb), 0.12);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25em 0.7em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--rule);
    color: var(--text-faint);
    white-space: nowrap;
  }
  .tag--teal { border-color: var(--teal); color: var(--teal); }
  .tag--gold { border-color: var(--gold); color: var(--gold); }

  .card-status {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    text-align: right;
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    line-height: 1.2;
    color: var(--text);
    margin: 0 0 0.3rem;
  }

  .card-subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--text-faint);
    margin: 0 0 0.9rem;
  }

  .card-thesis {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--text-dim);
    line-height: 1.7;
    margin: 0 0 1.5rem;
    max-width: 68ch;
  }

  /* ── Piece list — shares grammar with /project/[slug] (cn-pieces) so this
       page reads as the curated front door into the same constellation. ── */
  .card-pieces {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .card-piece {
    border-bottom: 1px solid var(--rule);
  }

  .card-piece a {
    display: flex;
    align-items: baseline;
    gap: 1em;
    padding: 0.85em 0;
    text-decoration: none;
  }

  .card-piece a:hover .piece-title,
  .card-piece a:focus-visible .piece-title {
    color: var(--teal);
  }

  .piece-label {
    font-family: var(--font-mono);
    font-size: 0.65em;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    width: 5.5em;
    flex-shrink: 0;
  }

  .piece-title {
    font-family: var(--font-display);
    font-size: 1.02em;
    color: var(--text);
    transition: color var(--transition-fast);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal);
    text-decoration: none;
    transition: gap var(--transition-fast);
  }
  .card-link:hover { gap: 0.75rem; }
  .card-link svg { width: 14px; height: 14px; flex-shrink: 0; }

  /* ── Also running — instruments strip ── */
  .instruments {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px dashed var(--rule);
  }

  .instruments-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0 0 1rem;
  }

  .instruments-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .instrument-row a {
    display: block;
    padding: 1.1rem 1.3rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }
  .instrument-row a:hover,
  .instrument-row a:focus-visible {
    border-color: rgba(var(--accent-rgb), 0.35);
  }

  .instrument-title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--text);
    margin-bottom: 0.3rem;
    transition: color var(--transition-fast);
  }
  .instrument-row a:hover .instrument-title { color: var(--teal); }

  .instrument-desc {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.55;
    color: var(--text-dim);
  }

  /* ── Prior chapter ── */
  .prior-chapter {
    padding: 2.5rem 0;
  }

  .prior-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0 0 0.75rem;
  }

  .prior-text {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.75;
    color: var(--text-faint);
    max-width: 68ch;
    margin: 0;
  }
  .prior-text em { color: var(--text-dim); font-style: italic; }

  /* ── Closing wayfinding ── */
  .work-wayfinding {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding-top: 1rem;
  }

  .wayfind-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 1.3rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .wayfind-link:hover,
  .wayfind-link:focus-visible {
    border-color: rgba(var(--accent-rgb), 0.35);
    background: rgba(var(--accent-rgb), 0.04);
  }

  .wayfind-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--text);
  }
  .wayfind-link:hover .wayfind-title { color: var(--teal); }

  .wayfind-desc {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
    line-height: 1.5;
  }

  /* ── Responsive ── */
  @media (max-width: 700px) {
    .instruments-list { grid-template-columns: 1fr; }
    .work-wayfinding { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .card-top { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
    .card-status { text-align: left; }
    .work-card { padding: 1.6rem 1.5rem; }
    .piece-label { width: 4.2em; }
  }
</style>
