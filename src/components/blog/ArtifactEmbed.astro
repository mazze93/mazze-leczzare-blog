---
interface Props {
  src: string;
  title: string;
  height?: number;
  caption?: string;
  fullscreenHref?: string;
}

const {
  src,
  title,
  height = 620,
  caption,
  fullscreenHref = src,
} = Astro.props;
---

<figure class="artifact-embed">
  <div class="artifact-frame-wrap" style={`height: ${height}px`}>
    <iframe
      src={src}
      title={title}
      class="artifact-frame"
      loading="lazy"
      scrolling="no"
      allowfullscreen
    ></iframe>
  </div>
  <figcaption class="artifact-caption">
    {caption && <span class="caption-text">{caption}</span>}
    <a href={fullscreenHref} class="fullscreen-link" target="_blank" rel="noopener noreferrer">
      Open full screen ↗
    </a>
  </figcaption>
</figure>

<style>
.artifact-embed {
  margin: 2.5em 0;
  border: 1px solid var(--rule);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.artifact-frame-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  /* was #0F1923 — a hardcoded dark that stayed dark under light mode */
  background: var(--surface);
}

.artifact-frame {
  display: block;
  width: 100%;
  height: 100%;
  border: none;
  background: transparent;
}

.artifact-caption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1em;
  padding: 0.65em 1em;
  border-top: 1px solid var(--rule);
  background: var(--surface, rgba(255,255,255,0.02));
}

.caption-text {
  font-family: var(--font-mono);
  font-size: 0.72em;
  color: var(--text-faint);
  line-height: 1.5;
  flex: 1;
}

.fullscreen-link {
  font-family: var(--font-mono);
  font-size: 0.68em;
  letter-spacing: 0.06em;
  color: var(--teal);
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
  transition: color var(--transition-fast);
}

.fullscreen-link:hover {
  color: var(--coral);
}

@media (max-width: 640px) {
  .artifact-caption {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4em;
  }
}
</style>
