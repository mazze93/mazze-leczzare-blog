---
/**
 * BreathingHero.astro
 * Homepage hero: the two shipped products, Stratum and Stele.
 *
 * This replaced a display headline ("From Erasure → Signal") that read as a
 * thesis rather than an answer. A reader landing here has one question —
 * what has this person built, and does it run — and the products were the
 * least visible things on the site. They lead now; the constellation and the
 * essays stay, one layer back.
 *
 * The two glyphs are deliberately not a shared icon set: Stratum draws its
 * append-only layers (newest band lit), Stele an inscribed upright slab. They
 * should read as two different objects at a glance, not two instances of one.
 *
 * Environmental breathing canvas — three zones:
 *   Zone 1 (left): noise particles, white, low opacity, random walk
 *   Zone 2 (center): emergence nodes, teal/magenta, teal connections
 *   Zone 3 (right): signal nodes, teal/amber/white, amber connections
 *
 * Nodes breathe darkness into surrounding space via slow radial gradient
 * pulsation. Mouse/touch interaction pulls nodes toward cursor.
 *
 * Respects prefers-reduced-motion (static gradient fallback).
 * Pauses when tab is hidden.
 */
import ConstellationNodes from "./constellation/ConstellationNodes";
---

<section class="breathing-hero" aria-label="Site introduction">
  <canvas class="breathing-hero__canvas" aria-hidden="true"></canvas>
  <div class="breathing-hero__content">
    <p class="breathing-hero__eyebrow">
      <span class="breathing-hero__live" aria-hidden="true"></span>
      Shipped &amp; running
    </p>
    <h1 class="breathing-hero__headline">
      I build systems that cannot conceal their own state.
    </h1>

    <div class="hero-nodes">
      <article class="hero-node hero-node--stratum">
        <svg class="hero-node__glyph" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <rect class="stratum-band stratum-band--new" x="6" y="9"  width="28" height="4" rx="1" />
          <rect class="stratum-band"                   x="6" y="17" width="23" height="4" rx="1" />
          <rect class="stratum-band"                   x="6" y="25" width="27" height="4" rx="1" />
          <rect class="stratum-band"                   x="6" y="33" width="18" height="3" rx="1" />
        </svg>
        <h2 class="hero-node__name">Stratum</h2>
        <p class="hero-node__role">epistemic decision ledger</p>
        <p class="hero-node__desc">
          An append-only ledger for human + AI work. Evidence — file hashes, test
          exits, signed approvals — stays separable from claim, so model prose
          never becomes authoritative just by being persisted.
        </p>
        <p class="hero-node__stack">TypeScript · Cloudflare Workers + Durable Objects · MIT</p>
        <a class="hero-node__link" href="https://stratum.mazzeleczzare.com/" target="_blank" rel="noopener noreferrer">
          Open Stratum <span aria-hidden="true">↗</span>
        </a>
      </article>

      <article class="hero-node hero-node--stele">
        <svg class="hero-node__glyph" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
          <path class="stele-slab" d="M20 4 L30 11 V36 H10 V11 Z" />
          <line class="stele-seal stele-seal--lit" x1="14" y1="19" x2="26" y2="19" />
          <line class="stele-seal" x1="14" y1="24" x2="26" y2="24" />
          <line class="stele-seal" x1="14" y1="29" x2="22" y2="29" />
        </svg>
        <h2 class="hero-node__name">Stele</h2>
        <p class="hero-node__role">directive compiler &amp; integrity layer</p>
        <p class="hero-node__desc">
          Compiles standing directives into per-project postures, so a collaborator
          inherits constraints as compiled state rather than vibes. Thirteen
          tripwires against authority drift, with a hard lockout when integrity
          cannot be re-established.
        </p>
        <p class="hero-node__stack">React 19 · TypeScript · Vite · Anthropic API</p>
        <a class="hero-node__link" href="https://stele.mazzeleczzare.com/" target="_blank" rel="noopener noreferrer">
          Open Stele <span aria-hidden="true">↗</span>
        </a>
      </article>
    </div>

    <div class="breathing-hero__actions">
      <a href="/work/" class="breathing-hero__cta">See the evidence</a>
      <a href="/blog/" class="breathing-hero__cta breathing-hero__cta--secondary">Read the writing</a>
      <a href="/about/" class="breathing-hero__cta breathing-hero__cta--secondary">About</a>
    </div>
    <p class="breathing-hero__orientation">
      Behind this: every point in the sky is a piece of work. Brightness is
      completion, gravity is connection — start at the
      <span class="breathing-hero__gold-word">gold signal</span>. Prefer a list?
      <a href="/writing/">The index</a> is the same sky, flattened.
    </p>
  </div>
  <ConstellationNodes client:load />
</section>

<style>
  .breathing-hero {
    position: relative;
    min-height: 100vh;
    display: grid;
    align-items: center;
    overflow: hidden;
    /* Was a hardcoded #0b0d12, which stayed navy under [data-theme="light"]
       and made the hero a dark slab on Haven paper. --home-bg is already
       mapped to the Haven surface in the light block of global.css. */
    background: var(--home-bg);

    /* ---- Hero-local palette -------------------------------------------
       Everything in this component used to be a dark-only literal: white
       text, white hairline borders, near-black card fills. Fixing only the
       section background turned the hero into white text on paper. These
       tokens carry the dark values as the base (dark is the site default)
       and are re-pointed under [data-theme="light"] below, so the hero has
       one palette switch rather than twenty scattered hexes. */
    --hero-ink:        #f2f4f8;
    --hero-ink-2:      rgba(242, 244, 248, 0.66);
    --hero-ink-3:      rgba(242, 244, 248, 0.5);
    --hero-ink-4:      rgba(242, 244, 248, 0.34);
    --hero-teal:       #2bd3c6;
    --hero-teal-hover: #34e8d9;
    --hero-gold:       #e8b64c;
    --hero-on-accent:  #0b0d12;
    --hero-card:       rgba(11, 13, 18, 0.62);
    --hero-card-hover: rgba(11, 13, 18, 0.78);
    --hero-card-solid: rgba(11, 13, 18, 0.8);
    --hero-edge:       rgba(255, 255, 255, 0.09);
    --hero-edge-hover: rgba(255, 255, 255, 0.18);
    --hero-edge-cta:   rgba(255, 255, 255, 0.12);
    --hero-edge-strong:rgba(255, 255, 255, 0.25);
    --hero-cta-wash:   rgba(255, 255, 255, 0.04);
    --hero-halo:       rgba(11, 13, 18, 0.9);
  }

  /* Haven/Ink values for the same slots. The accents go deeper rather than
     lighter — the dark teal and amber are near-invisible on warm paper, and
     both carry text (CTA label, gold word, node links), so they need to hold
     contrast against #f4f0e7 rather than glow against near-black. */
  :global([data-theme="light"]) .breathing-hero {
    --hero-ink:        var(--ink);
    --hero-ink-2:      var(--ink-2);
    --hero-ink-3:      var(--ink-3);
    --hero-ink-4:      var(--ink-ghost);
    --hero-teal:       #10635c;
    --hero-teal-hover: #0b4a45;
    --hero-gold:       #7a622c;
    --hero-on-accent:  #f9f6ee;
    --hero-card:       rgba(249, 246, 238, 0.72);
    --hero-card-hover: rgba(249, 246, 238, 0.92);
    --hero-card-solid: rgba(249, 246, 238, 0.94);
    --hero-edge:       var(--wash-14);
    --hero-edge-hover: var(--wash-22);
    --hero-edge-cta:   var(--wash-14);
    --hero-edge-strong:var(--wash-38);
    --hero-cta-wash:   var(--wash-4);
    --hero-halo:       rgba(244, 240, 231, 0.9);
  }

  .breathing-hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .breathing-hero__content {
    position: relative;
    z-index: 10;
    text-align: left;
    padding: 6rem clamp(1.25rem, 5vw, 3rem) 4rem;
    max-width: 1060px;
    margin-inline: auto;
    width: 100%;
    animation: heroFadeIn 1.2s ease-out both;
    /* Let the pointer reach the canvas nodes underneath; links opt back in. */
    pointer-events: none;
  }

  .breathing-hero__content a {
    pointer-events: auto;
  }

  /* The plate's orientation line, adapted: one sky, same welcome. */
  /* In flow, below the CTAs. It used to sit absolutely positioned at the top
     left, which worked against a right-aligned headline but collided with the
     eyebrow once the content became a centred two-column block. It is an aid
     for reading the constellation, so it belongs after the thing it explains. */
  .breathing-hero__orientation {
    position: relative;
    z-index: 10;
    font-family: var(--font-display, Georgia, serif);
    font-style: italic;
    font-size: clamp(0.92rem, 1.2vw, 1.05rem);
    line-height: 1.6;
    max-width: 62ch;
    color: var(--hero-ink-3);
    margin: 2.25rem 0 0;
    pointer-events: none;
    text-shadow: 0 1px 18px var(--hero-halo);
    animation: heroFadeIn 1.2s ease-out both;
  }
  .breathing-hero__orientation a {
    color: var(--hero-teal);
    pointer-events: auto;
  }
  .breathing-hero__gold-word {
    color: var(--hero-gold);
    font-style: normal;
  }

  .breathing-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--hero-teal);
    margin: 0 0 1.1rem;
  }

  .breathing-hero__live {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hero-teal);
    box-shadow: 0 0 0 3px rgba(43, 211, 198, 0.16);
  }

  .breathing-hero__headline {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.9rem, 4.4vw, 3.4rem);
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--hero-ink);
    margin: 0 0 2.75rem;
    line-height: 1.1;
    max-width: 20ch;
  }

  /* ── The two product nodes ── */
  .hero-nodes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .hero-node {
    position: relative;
    padding: 1.6rem 1.5rem 1.5rem;
    border: 1px solid var(--hero-edge);
    border-radius: 10px;
    background: var(--hero-card);
    backdrop-filter: blur(7px);
    -webkit-backdrop-filter: blur(7px);
    pointer-events: auto;
    transition: border-color 0.25s ease, transform 0.25s ease, background 0.25s ease;
  }

  /* Each node carries its own accent so the pair never reads as one repeated
     card: Stratum teal (the ledger), Stele amber (the seal). */
  .hero-node--stratum { --node-accent: var(--hero-teal); }
  .hero-node--stele   { --node-accent: var(--hero-gold); }

  .hero-node::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    border-radius: 10px 0 0 10px;
    background: var(--node-accent);
    opacity: 0.55;
    transition: opacity 0.25s ease;
  }

  .hero-node:hover {
    border-color: var(--hero-edge-hover);
    background: var(--hero-card-hover);
    transform: translateY(-2px);
  }

  .hero-node:hover::before { opacity: 1; }

  .hero-node__glyph {
    width: 34px;
    height: 34px;
    display: block;
    margin-bottom: 0.9rem;
  }

  /* Stratum — append-only layers, newest band lit. */
  .stratum-band { fill: var(--hero-ink-4); }
  .stratum-band--new { fill: var(--node-accent); }

  /* Stele — an inscribed upright slab. */
  .stele-slab {
    fill: none;
    stroke: var(--hero-ink-4);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .stele-seal {
    stroke: var(--hero-ink-4);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .stele-seal--lit { stroke: var(--node-accent); }

  .hero-node__name {
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.55rem;
    font-weight: 400;
    color: var(--hero-ink);
    margin: 0;
    line-height: 1.1;
  }

  .hero-node__role {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--node-accent);
    margin: 0.4rem 0 0.85rem;
  }

  .hero-node__desc {
    font-family: var(--font-mono, monospace);
    font-size: 0.79rem;
    line-height: 1.65;
    color: var(--hero-ink-2);
    margin: 0 0 1rem;
  }

  .hero-node__stack {
    font-family: var(--font-mono, monospace);
    font-size: 0.66rem;
    letter-spacing: 0.03em;
    color: var(--hero-ink-4);
    margin: 0 0 1.1rem;
  }

  .hero-node__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-mono, monospace);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--node-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .hero-node__link:hover { border-bottom-color: var(--node-accent); }

  .hero-node__link:focus-visible,
  .breathing-hero__cta:focus-visible {
    outline: 2px solid var(--node-accent, var(--hero-teal));
    outline-offset: 3px;
  }

  .breathing-hero__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .breathing-hero__cta {
    display: inline-block;
    padding: 0.7rem 1.5rem;
    border-radius: 6px;
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.2s ease;
  }

  .breathing-hero__cta:not(.breathing-hero__cta--secondary) {
    background: var(--hero-teal);
    color: var(--hero-on-accent);
  }

  .breathing-hero__cta:not(.breathing-hero__cta--secondary):hover {
    background: var(--hero-teal-hover);
    box-shadow: 0 4px 20px rgba(43, 211, 198, 0.3);
    transform: translateY(-1px);
  }

  .breathing-hero__cta--secondary {
    background: transparent;
    color: var(--hero-ink-2);
    border: 1px solid var(--hero-edge-cta);
  }

  .breathing-hero__cta--secondary:hover {
    color: var(--hero-ink);
    border-color: var(--hero-edge-strong);
    background: var(--hero-cta-wash);
  }

  @keyframes heroFadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .breathing-hero {
      /* Same literal problem as the animated case: reduced-motion visitors on
         light mode got the navy gradient. --home-bg/--home-surface both flip. */
      background: linear-gradient(90deg, var(--home-bg) 0%, var(--home-surface) 100%);
    }
    .breathing-hero__canvas {
      display: none;
    }
    .breathing-hero__content {
      animation: none;
    }
    .breathing-hero__orientation {
      animation: none;
    }
    .hero-node {
      transition: none;
    }
    .breathing-hero__cta {
      transition: none;
    }
  }

  @media (max-width: 768px) {
    /* the mobile node list replaces the sky; nothing to orient against */
    .breathing-hero__orientation {
      display: none;
    }
    .breathing-hero__content {
      padding: 4.5rem 1.25rem 3rem;
    }
    .hero-nodes {
      grid-template-columns: 1fr;
    }
    .hero-node {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: var(--hero-card-solid);
    }
    .breathing-hero__cta {
      flex: 1 1 auto;
      text-align: center;
    }
  }
</style>

<script>
  interface NoiseParticle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    opacity: number;
  }

  interface BreathingNode {
    x: number;
    y: number;
    baseX: number;
    baseY: number;
    zone: 2 | 3;
    size: number;
    baseOpacity: number;
    breathPhase: number;
    breathSpeed: number;
    darknessRadius: number;
    color: 'teal' | 'magenta' | 'amber' | 'white';
  }

  interface NodeConnection {
    node1: BreathingNode;
    node2: BreathingNode;
    opacity: number;
    targetOpacity: number;
    zone: 2 | 3;
    formed: boolean;
    formationDelay: number;
    mouseInfluence: number;
  }

  function initBreathingCanvas() {
    const canvas = document.querySelector<HTMLCanvasElement>('.breathing-hero__canvas');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Skip animation for reduced-motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    interface Palette {
      trailBg: string; trailA: number;
      particle: string; shadow: string;
      c2: string; c3: string;
      nodes: { teal: string; magenta: string; amber: string; white: string };
    }
    const DARK: Palette = {
      trailBg: '11, 13, 18',    trailA: 0.40,
      particle: '242, 244, 248', shadow: '11, 13, 18',
      c2: '43, 211, 198',        c3: '244, 162, 97',
      nodes: { teal: '43, 211, 198', magenta: '192, 75, 183', amber: '244, 162, 97', white: '242, 244, 248' },
    };
    const LIGHT: Palette = {
      // trailBg has to BE the page ground, not merely a light grey: the trail
      // fade paints this colour over the whole canvas every frame, so any
      // mismatch tints the hero away from the rest of the page. '216, 218, 210'
      // read as a grey-green panel sitting on cream. This is --hv-surface.
      // trailA also had to come up — at 0.30 the gravity-well shadows never
      // fully cleared between frames and stacked into grey discs.
      trailBg: '244, 240, 231',  trailA: 0.46,
      // Warm ink shadow rather than the old blue-black, to match Haven paper.
      particle: '36, 44, 54',    shadow: '28, 23, 20',
      c2: '14, 82, 72',          c3: '112, 66, 14',
      nodes: { teal: '14, 82, 72', magenta: '92, 26, 82', amber: '118, 70, 14', white: '172, 162, 144' },
    };
    function getPalette(): Palette {
      return document.documentElement.dataset.theme === 'light' ? LIGHT : DARK;
    }

    let width = 0;
    let height = 0;
    let particles: NoiseParticle[] = [];
    let graticule: { ox: number; oy: number }[][] = [];
    let nodes: BreathingNode[] = [];
    let connections: NodeConnection[] = [];
    let mouse = { x: -999, y: -999 };
    let palette = getPalette();

    // getPalette() was called exactly once at startup, so toggling the theme
    // with the homepage open left the canvas painted in the outgoing palette
    // until a reload. data-theme is set on <html> by BaseHead and ThemeToggle.
    const themeObserver = new MutationObserver(() => { palette = getPalette(); });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    let animId = 0;

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      initSystem();
    }

    function makeNode(x: number, y: number, zone: 2 | 3): BreathingNode {
      const isZone2 = zone === 2;
      let color: BreathingNode['color'];
      if (isZone2) {
        color = Math.random() > 0.5 ? 'teal' : 'magenta';
      } else {
        const r = Math.random();
        color = r < 0.4 ? 'teal' : r < 0.7 ? 'amber' : 'white';
      }
      return {
        x, y, baseX: x, baseY: y, zone,
        size: isZone2 ? Math.random() * 2 + 1.5 : Math.random() * 2.5 + 2,
        baseOpacity: isZone2 ? Math.random() * 0.5 + 0.4 : Math.random() * 0.7 + 0.5,
        breathPhase: Math.random() * Math.PI * 2,
        breathSpeed: 0.0008 + Math.random() * 0.0004,
        darknessRadius: isZone2 ? 80 : 120,
        color,
      };
    }

    function initSystem() {
      particles = [];
      nodes = [];
      connections = [];

      // Survey graticule — the rigid grid gravity gets to bend (approved
      // spec pull). Atmosphere may warp; truth nodes keep their own physics.
      graticule = [];
      const step = Math.max(120, width / 14);
      const sample = 48;
      for (let x = step; x < width; x += step) {
        const line: { ox: number; oy: number }[] = [];
        for (let y = 0; y <= height; y += sample) line.push({ ox: x, oy: y });
        graticule.push(line);
      }
      for (let y = step; y < height; y += step) {
        const line: { ox: number; oy: number }[] = [];
        for (let x = 0; x <= width; x += sample) line.push({ ox: x, oy: y });
        graticule.push(line);
      }

      // Zone 1: noise particles (left third)
      for (let i = 0; i < 60; i++) {
        particles.push({
          x: Math.random() * (width / 3),
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.2,
          vy: (Math.random() - 0.5) * 0.2,
          size: Math.random() * 1.5 + 0.5,
          opacity: Math.random() * 0.15 + 0.05,
        });
      }

      // Zone 2: emergence nodes (middle third) — ambient counts kept below
      // the truth-node layer's presence: atmosphere, not subject
      const zone2Nodes: BreathingNode[] = [];
      for (let i = 0; i < 24; i++) {
        const n = makeNode(
          width / 3 + Math.random() * (width / 3),
          Math.random() * height,
          2
        );
        nodes.push(n);
        zone2Nodes.push(n);
      }
      zone2Nodes.forEach(n => {
        zone2Nodes
          .filter(o => { const dx = n.x - o.x; const dy = n.y - o.y; const d = Math.sqrt(dx*dx + dy*dy); return d < 160 && d > 0; })
          .slice(0, 3)
          .forEach(o => connections.push(makeConnection(n, o, 2)));
      });

      // Zone 3: signal nodes (right third)
      const zone3Nodes: BreathingNode[] = [];
      for (let i = 0; i < 32; i++) {
        const n = makeNode(
          (width / 3) * 2 + Math.random() * (width / 3),
          Math.random() * height,
          3
        );
        nodes.push(n);
        zone3Nodes.push(n);
      }
      zone3Nodes.forEach(n => {
        zone3Nodes
          .filter(o => { const dx = n.x - o.x; const dy = n.y - o.y; const d = Math.sqrt(dx*dx + dy*dy); return d < 180 && d > 0; })
          .slice(0, 4)
          .forEach(o => connections.push(makeConnection(n, o, 3)));
      });
    }

    function makeConnection(node1: BreathingNode, node2: BreathingNode, zone: 2 | 3): NodeConnection {
      return {
        node1, node2, zone,
        opacity: 0,
        targetOpacity: zone === 2 ? Math.random() * 0.12 + 0.06 : Math.random() * 0.2 + 0.12,
        formed: false,
        formationDelay: Math.random() * 4000,
        mouseInfluence: 0,
      };
    }

    function nodeMouseInfluence(n: BreathingNode): number {
      const dx = mouse.x - n.x;
      const dy = mouse.y - n.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      return dist < 150 ? (150 - dist) / 150 : 0;
    }

    function updateParticle(p: NoiseParticle) {
      p.x += p.vx;
      p.y += p.vy;
      if (p.x < 0) p.x = width / 3;
      if (p.x > width / 3) p.x = 0;
      if (p.y < 0) p.y = height;
      if (p.y > height) p.y = 0;
      p.vx += (Math.random() - 0.5) * 0.015;
      p.vy += (Math.random() - 0.5) * 0.015;
      p.vx *= 0.99;
      p.vy *= 0.99;
    }

    function updateNode(n: BreathingNode) {
      n.breathPhase += n.breathSpeed;
      const dx = mouse.x - n.x;
      const dy = mouse.y - n.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < 150) {
        const force = (150 - dist) / 150;
        n.x += dx * force * 0.03;
        n.y += dy * force * 0.03;
      }
      n.x += (n.baseX - n.x) * 0.03;
      n.y += (n.baseY - n.y) * 0.03;
    }

    function drawParticle(p: NoiseParticle) {
      ctx!.fillStyle = `rgba(${palette.particle}, ${p.opacity})`;
      ctx!.beginPath();
      ctx!.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx!.fill();
    }

    function drawNode(n: BreathingNode) {
      const breathCycle = Math.sin(n.breathPhase);
      const darknessIntensity = (breathCycle + 1) / 2;
      const rgb = palette.nodes[n.color];
      const isLight = palette === LIGHT;
      // The gravity-well shadow was tuned against near-black. On Haven paper
      // the same alphas stack into visible grey discs wherever wells overlap,
      // so the field is damped rather than dropped — the lensing still reads,
      // it just stops bruising the page.
      const fieldScale = isLight ? 0.22 : 1;

      // Shadow/void field.
      // Dark mode: shadow pools around the node (darkens local space).
      // Light mode: shadow radiates outward — concentrates in the void *between* nodes.
      const fieldGrad = ctx!.createRadialGradient(n.x, n.y, n.size, n.x, n.y, n.darknessRadius);
      if (isLight) {
        fieldGrad.addColorStop(0,    `rgba(${palette.shadow}, 0)`);
        fieldGrad.addColorStop(0.42, `rgba(${palette.shadow}, ${darknessIntensity * 0.07 * fieldScale})`);
        fieldGrad.addColorStop(0.70, `rgba(${palette.shadow}, ${darknessIntensity * 0.14 * fieldScale})`);
        fieldGrad.addColorStop(1,    `rgba(${palette.shadow}, ${darknessIntensity * 0.21 * fieldScale})`);
      } else {
        fieldGrad.addColorStop(0,   `rgba(${palette.shadow}, 0)`);
        fieldGrad.addColorStop(0.3, `rgba(${palette.shadow}, ${darknessIntensity * 0.15 * fieldScale})`);
        fieldGrad.addColorStop(0.6, `rgba(${palette.shadow}, ${darknessIntensity * 0.25 * fieldScale})`);
        fieldGrad.addColorStop(1,   `rgba(${palette.shadow}, ${darknessIntensity * 0.10 * fieldScale})`);
      }
      ctx!.fillStyle = fieldGrad;
      ctx!.beginPath();
      ctx!.arc(n.x, n.y, n.darknessRadius, 0, Math.PI * 2);
      ctx!.fill();

      // Color halo — larger radius in light mode, colors bleed into sky
      const glowR = n.size * (isLight ? 4.5 : 3);
      const glowGrad = ctx!.createRadialGradient(n.x, n.y, 0, n.x, n.y, glowR);
      glowGrad.addColorStop(0,   `rgba(${rgb}, ${n.baseOpacity * (isLight ? 0.28 : 0.40)})`);
      glowGrad.addColorStop(0.5, `rgba(${rgb}, ${n.baseOpacity * (isLight ? 0.10 : 0.15)})`);
      glowGrad.addColorStop(1,   `rgba(${rgb}, 0)`);
      ctx!.fillStyle = glowGrad;
      ctx!.beginPath();
      ctx!.arc(n.x, n.y, glowR, 0, Math.PI * 2);
      ctx!.fill();

      // Core dot
      ctx!.fillStyle = `rgba(${rgb}, ${n.baseOpacity * (isLight ? 0.88 : 1.0)})`;
      ctx!.beginPath();
      ctx!.arc(n.x, n.y, n.size, 0, Math.PI * 2);
      ctx!.fill();
    }

    function updateConnection(c: NodeConnection) {
      if (!c.formed && Date.now() % 12000 > c.formationDelay) c.formed = true;
      if (c.formed) c.opacity += (c.targetOpacity - c.opacity) * 0.015;
      const i1 = nodeMouseInfluence(c.node1);
      const i2 = nodeMouseInfluence(c.node2);
      c.mouseInfluence = Math.max(i1, i2);
    }

    function drawConnection(c: NodeConnection) {
      if (c.opacity < 0.01) return;
      const finalOpacity = c.opacity * (1 + c.mouseInfluence * 1.5);
      const color = c.zone === 2 ? '43, 211, 198' : '244, 162, 97';
      ctx!.strokeStyle = `rgba(${color}, ${finalOpacity})`;
      ctx!.lineWidth = 1 + c.mouseInfluence;
      ctx!.beginPath();
      ctx!.moveTo(c.node1.x, c.node1.y);
      ctx!.lineTo(c.node2.x, c.node2.y);
      ctx!.stroke();
    }

    function animate() {
      animId = requestAnimationFrame(animate);

      // Trail fade (instead of clearRect — creates motion blur).
      // This used to be a hardcoded 'rgba(11, 13, 18, 0.4)'. Every other draw
      // call reads `palette`, and both DARK and LIGHT declare trailBg/trailA —
      // but nothing ever read them, so this one line repainted the canvas deep
      // navy on every frame and the hero stayed a dark slab on paper no matter
      // what the theme was. That was the whole homepage light-mode bug.
      ctx!.fillStyle = `rgba(${palette.trailBg}, ${palette.trailA})`;
      ctx!.fillRect(0, 0, width, height);

      drawGraticule();
      particles.forEach(p => { updateParticle(p); drawParticle(p); });
      nodes.forEach(n => updateNode(n));
      connections.forEach(c => { updateConnection(c); drawConnection(c); });
      nodes.forEach(n => drawNode(n));
    }

    // Bend each graticule vertex toward the cursor — gravitational lensing
    // as interaction. Pull field matches the node physics (300px reach).
    function drawGraticule() {
      ctx!.strokeStyle = `rgba(${palette.particle}, 0.045)`;
      ctx!.lineWidth = 1;
      for (const line of graticule) {
        ctx!.beginPath();
        for (let i = 0; i < line.length; i++) {
          const v = line[i];
          let x = v.ox;
          let y = v.oy;
          const dx = mouse.x - v.ox;
          const dy = mouse.y - v.oy;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 300 && dist > 0.001) {
            const pull = (1 - dist / 300) * 26;
            x += (dx / dist) * pull;
            y += (dy / dist) * pull;
          }
          if (i === 0) ctx!.moveTo(x, y);
          else ctx!.lineTo(x, y);
        }
        ctx!.stroke();
      }
    }

    function handleVisibility() {
      if (document.hidden) {
        cancelAnimationFrame(animId);
      } else {
        animId = requestAnimationFrame(animate);
      }
    }

    canvas.addEventListener('mousemove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; });
    canvas.addEventListener('mouseleave', () => { mouse.x = -999; mouse.y = -999; });
    canvas.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) { mouse.x = e.touches[0].clientX; mouse.y = e.touches[0].clientY; }
    }, { passive: true });

    window.addEventListener('resize', resize);
    document.addEventListener('visibilitychange', handleVisibility);

    resize();
    animId = requestAnimationFrame(animate);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBreathingCanvas);
  } else {
    initBreathingCanvas();
  }
</script>
