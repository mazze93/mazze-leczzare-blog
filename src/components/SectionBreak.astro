---
/**
 * SectionBreak.astro
 * Decorative in-prose divider — a quiet pause between movements of an essay.
 * Purely presentational: hidden from assistive tech, carries no semantic weight.
 *
 * A kintsugi seam drawn as a brush stroke: the break in the page is the gold.
 *
 * Geometry is the Haven / Ink "section-divider" mark (Mark B, 340×22) from the
 * light-mode prototype, worked in gold instead of Indian ink. It is NOT a
 * stroked line — it is two closed Bézier paths, out and back, so the mark
 * swells at the middle and tapers to a point at each end the way a loaded
 * brush does. Three layers, all from the original:
 *
 *   1. bleed    — a wider, near-transparent copy: pigment spreading into paper
 *   2. body     — the stroke itself, carrying the gold gradient
 *   3. touchdown/lift — ellipses where the brush met the page and left it
 *
 * A constant-width stroke cannot do any of this; that is the whole point of
 * borrowing the geometry rather than approximating it.
 *
 * Usage:
 *   <SectionBreak />
 */

// Unique gradient id per instance — duplicate ids are invalid HTML and an essay
// can carry several dividers. Astro re-runs frontmatter per instance, so a
// module-level counter would not survive.
const uid = `seam-${crypto.randomUUID().slice(0, 8)}`;

// Haven / Ink Mark B — body and bleed share endpoints so they read as one mark.
const BODY =
  "M4,11 C30,4 80,7.5 155,9 C210,10 272,8.5 336,11 C272,13.5 210,15 155,13 C80,14.5 30,17.5 4,11 Z";
const BLEED =
  "M4,11 C28,2 78,5 155,7 C212,8 274,6.5 336,11 C274,15.5 212,16 155,15 C78,17 28,20 4,11 Z";
---

<div class="section-break" role="presentation" aria-hidden="true">
  <svg class="section-break__seam" viewBox="0 0 340 22" fill="none" focusable="false">
    <defs>
      <linearGradient id={uid} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0"    stop-color="var(--gold-seam-deep)" />
        <stop offset="0.32" stop-color="var(--gold-seam)" />
        <stop offset="0.52" stop-color="var(--gold-seam-bright)" />
        <stop offset="0.72" stop-color="var(--gold-seam)" />
        <stop offset="1"    stop-color="var(--gold-seam-deep)" />
      </linearGradient>
    </defs>
    <path class="section-break__bleed" d={BLEED} fill={`url(#${uid})`} />
    <path class="section-break__body"  d={BODY}  fill={`url(#${uid})`} />
    <ellipse class="section-break__touch" cx="4"   cy="11" rx="2.2" ry="2.8" fill={`url(#${uid})`} />
    <ellipse class="section-break__lift"  cx="336" cy="11" rx="1.8" ry="2.4" fill={`url(#${uid})`} />
  </svg>
</div>

<style>
  .section-break {
    margin: var(--spacing-xl, 4rem) auto;
    width: min(21rem, 72%);
  }

  .section-break__seam {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    /* Laid down left to right, the way it would be painted. clip-path rather
       than stroke-dashoffset because these are fills, not strokes. */
    animation: seam-lay 1.4s cubic-bezier(0.32, 0, 0.24, 1) forwards;
    clip-path: inset(0 100% 0 0);
  }

  /* Gold on obsidian: the bleed reads as leaf-scatter, so it can carry a
     little glow. Opacities follow the Haven original's ink/paper ratio. */
  .section-break__bleed { opacity: 0.07; }
  .section-break__body  { opacity: 0.92; }
  .section-break__touch { opacity: 0.5; }
  .section-break__lift  { opacity: 0.34; }

  /* On paper the same mark has to behave like pigment, not light: the bleed
     spreads a touch more and the body sits down harder into the ground. */
  :global([data-theme="light"]) .section-break__bleed { opacity: 0.1; }
  :global([data-theme="light"]) .section-break__body  { opacity: 1; }

  @keyframes seam-lay {
    to { clip-path: inset(0 0 0 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-break__seam {
      animation: none;
      clip-path: none;
    }
  }
</style>
