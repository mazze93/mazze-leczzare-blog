---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			// Frontmatter dates are UTC midnight. Without this, a build in a
			// negative-offset zone (EDT) prints the previous day while a UTC build
			// server prints the right one.
			timeZone: 'UTC',
		})
	}
</time>
