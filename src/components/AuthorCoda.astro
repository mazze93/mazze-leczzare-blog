---
import { SITE_AUTHOR } from '../consts';
import Seam from './Seam.astro';

interface Props {
  headshot?: string;
  contentType?: 'artifact' | 'dispatch' | 'field-note';
  repoUrl?: string;
}

const {
  headshot = '/mazze-headshot.jpg',
  contentType = 'field-note',
  repoUrl,
} = Astro.props;
---

<aside class="author-coda" aria-label="About the author">
  <span class="coda-seam" aria-hidden="true"><Seam /></span>
  <div class="coda-inner">
    <div class="coda-avatar-wrap">
      <img
        src={headshot}
        alt={SITE_AUTHOR}
        width={72}
        height={72}
        class="coda-avatar"
        loading="lazy"
        decoding="async"
        onerror="this.style.display='none';this.nextElementSibling.removeAttribute('hidden')"
      />
      <div class="coda-avatar-fallback" hidden aria-hidden="true"></div>
    </div>
    <div class="coda-text">
      <span class="coda-byline">Written by {SITE_AUTHOR}</span>
      {contentType === 'artifact' && (
        <p class="coda-bio">
          Content strategist, security researcher, and founder of{' '}
          <a href="https://securepride.org">Secure Pride</a> — a privacy-first cybersecurity
          nonprofit built for LGBTQ+ organizations. Former neuroscientist. Essays on memory,
          infrastructure, and the cost of not naming things.
        </p>
      )}
      {contentType === 'artifact' && repoUrl && (
        <p class="coda-artifact-note">
          Artifacts and session materials for this post live in
          <a href={repoUrl} target="_blank" rel="noopener noreferrer">the repository</a>.
        </p>
      )}
      {contentType === 'dispatch' && (
        <p class="coda-bio">
          Written by {SITE_AUTHOR}. Dispatches are adversarial arguments —
          read them as a position, not a survey.
          Founder of <a href="https://securepride.org">Secure Pride</a>.
        </p>
      )}
      {contentType === 'field-note' && (
        <p class="coda-bio">
          Content strategist, security researcher, and founder of{' '}
          <a href="https://securepride.org">Secure Pride</a> — a privacy-first cybersecurity
          nonprofit built for LGBTQ+ organizations. Former neuroscientist. Essays on memory,
          infrastructure, and the cost of not naming things.
        </p>
      )}
    </div>
  </div>
</aside>

<style>
.author-coda {
  width: 720px;
  max-width: calc(100% - 2em);
  margin: 0 auto;
  padding: 2.5em 1em 4em;
  /* was: border-top: 1px solid var(--rule). The coda is where the essay breaks
     and the author steps out from behind it — the seam belongs here more than
     on any other rule in the layout. */
  position: relative;
}

.coda-seam {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: block;
  /* A rule, not a statement — the coda seam stays fine. Taller values
     read as a blot because preserveAspectRatio="none" stretches the
     brush's 22-unit height across the full 720px column. */
  height: 7px;
  pointer-events: none;
}

/* The SVG derives its own height from the viewBox ratio (340x22), so at a
   720px column it renders ~46px tall regardless of the wrapper. Constrain the
   mark itself — a coda rule should be fine, not a blot. */
.coda-seam :global(.seam) {
  height: 7px;
}

.coda-inner {
  display: flex;
  align-items: flex-start;
  gap: 1.25rem;
}

.coda-avatar-wrap {
  flex-shrink: 0;
}

.coda-avatar {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  object-fit: cover;
  border: 1px solid var(--rule);
  display: block;
}

.coda-avatar-fallback {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: var(--surface);
  border: 1px solid var(--rule);
}

.coda-text {
  display: flex;
  flex-direction: column;
  gap: 0.4em;
  padding-top: 0.15em;
}

.coda-byline {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-faint);
}

.coda-bio {
  /* was var(--font-body, …) — --font-body lived only in editorial.css,
     which is retired; the fallback was always what rendered. */
  font-family: var(--font-mono);
  font-size: 0.88rem;
  color: var(--text-dim);
  line-height: 1.65;
  margin: 0;
}

.coda-artifact-note {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--text-faint);
  line-height: 1.55;
  margin: 0;
}

.coda-bio a,
.coda-artifact-note a {
  color: var(--teal);
  text-decoration: none;
  border-bottom: 1px solid rgba(var(--accent-rgb), 0.25);
  transition: color var(--transition-fast), border-color var(--transition-fast);
}

.coda-bio a:hover,
.coda-artifact-note a:hover {
  color: var(--coral);
  border-bottom-color: rgba(var(--coral-rgb), 0.35);
}

@media (max-width: 480px) {
  .coda-inner {
    flex-direction: column;
    gap: 1rem;
  }
}
</style>
