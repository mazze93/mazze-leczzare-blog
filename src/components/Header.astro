---
import { SITE_TITLE, COMPASS_LABEL } from '../consts';
import ThemeToggle from './ThemeToggle';
import CompassLink from './CompassLink.astro';

/**
 * minimal — masthead only (brand + utilities), no atlas nav. For pages that
 * mount AirlockStrip: there the airlock is the door and the sky is the
 * territory; a second nav band on top of both reads as redundancy, not
 * orientation. Inner pages keep the full atlas.
 */
export interface Props {
  minimal?: boolean;
}
const { minimal = false } = Astro.props;
---

<header role="banner">
  <nav aria-label="Main navigation">
    <div class="brand">
      <CompassLink href="/" label={COMPASS_LABEL} size={32} />
      <a href="/" class="wordmark" aria-label={`${SITE_TITLE} — home`}>{SITE_TITLE}</a>
    </div>
    {!minimal && (
      <div class="nav-links">
        <a href="/work/">Work</a>
        <a href="/writing/">Writing</a>
        <a href="/about/">About</a>
        <a href="/studio/">Studio</a>
        <a href="/signal/">Signal</a>
        <span class="nav-rule" aria-hidden="true"></span>
        <a class="nav-product" href="https://stratum.mazzeleczzare.com/" target="_blank" rel="noopener noreferrer">Stratum<span class="nav-live" aria-hidden="true"></span><span class="sr-only"> (live app, opens in a new tab)</span></a>
        <a class="nav-product" href="https://stele.mazzeleczzare.com/" target="_blank" rel="noopener noreferrer">Stele<span class="nav-live" aria-hidden="true"></span><span class="sr-only"> (live app, opens in a new tab)</span></a>
      </div>
    )}
    <div class="nav-util">
      <a href="https://github.com/mazze93" target="_blank" rel="noopener noreferrer" class="util-link">GitHub</a>
      <ThemeToggle client:load />
    </div>
  </nav>
</header>

<style>
header {
  position: sticky;
  top: 0;
  z-index: var(--z-header);
  background: var(--header-bg);
  border-bottom: 1px solid var(--rule);
}

@supports ((backdrop-filter: blur(8px)) or (-webkit-backdrop-filter: blur(8px))) {
  header {
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
}

nav {
  display: flex;
  align-items: center;
  gap: 2em;
  max-width: 960px;
  margin: 0 auto;
  padding: 0 1.5em;
  min-height: 56px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.6em;
  flex-shrink: 0;
}

.wordmark {
  font-family: var(--font-display);
  font-size: 1.1em;
  font-weight: 500;
  color: var(--text);
  text-decoration: none;
  letter-spacing: 0.02em;
  transition: color var(--transition-fast);
}

.wordmark:hover {
  color: var(--teal);
}

/* The two shipped products. They were reachable only from inside /work/ and
   /writing/ — never the homepage, never the nav — which buried the strongest
   evidence on the site behind two clicks. The teal dot marks them as running
   software rather than another essay. */
.nav-rule {
  width: 1px;
  height: 14px;
  background: var(--rule);
  margin: 0 0.35em;
  flex-shrink: 0;
}

.nav-product {
  display: inline-flex;
  align-items: center;
  gap: 0.4em;
}

.nav-live {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--teal);
  box-shadow: 0 0 0 2px rgba(var(--accent-rgb), 0.18);
}

.sr-only {
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 0.25em;
  flex: 1;
}

.nav-links a {
  font-family: var(--font-sans);
  font-size: 0.95rem;
  text-transform: none;
  letter-spacing: normal;
  color: var(--text-dim);
  text-decoration: none;
  padding: 0.4em 0.7em;
  transition: color var(--transition-fast);
}

.nav-links a:hover,
.nav-links a[aria-current="page"] {
  color: var(--teal);
}

.nav-util {
  display: flex;
  align-items: center;
  gap: 0.5em;
  margin-left: auto;
}

.util-link {
  font-family: var(--font-mono);
  font-size: 0.72em;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-faint);
  text-decoration: none;
  padding: 0.3em 0.6em;
  border: 1px solid var(--rule);
  border-radius: var(--radius-sm);
  transition: color var(--transition-fast), border-color var(--transition-fast);
}

.util-link:hover {
  color: var(--teal);
  border-color: rgba(var(--accent-rgb), 0.3);
}

:global(.theme-toggle) {
  font-family: var(--font-mono);
  font-size: 0.72em;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-faint);
  background: transparent;
  border: 1px solid var(--rule);
  border-radius: var(--radius-sm);
  padding: 0.3em 0.6em;
  cursor: pointer;
  line-height: 1.6;
  transition: color var(--transition-fast), border-color var(--transition-fast);
}

:global(.theme-toggle:hover) {
  color: var(--teal);
  border-color: rgba(var(--accent-rgb), 0.3);
}

:global(.theme-toggle:focus-visible) {
  outline: 2px solid var(--teal);
  outline-offset: 2px;
}

.wordmark:focus-visible,
.nav-links a:focus-visible,
.util-link:focus-visible {
  outline: 2px solid var(--teal);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

@media (max-width: 640px) {
  nav {
    gap: 1em;
    padding: 0 1em;
    min-height: 48px;
    flex-wrap: wrap;
  }
  .nav-util {
    display: flex;
    margin-left: auto;
  }
  .util-link { display: none; }
  :global(.theme-toggle) { display: inline-flex; }
  .nav-links a { padding: 0.3em 0.5em; }
}
</style>

<script>
  // The constellation node layer dispatches `compass:state` as the reader
  // hovers/focuses/clicks nodes; the brand compass refracts in response.
  // compass.css already transitions the [data-state] visuals.
  const compass = document.querySelector<HTMLElement>(".brand .compass");
  if (compass) {
    let resetTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener("compass:state", (event) => {
      const detail = (event as CustomEvent<{ state?: string }>).detail;
      if (!detail?.state) return;
      clearTimeout(resetTimer);
      compass.dataset.state = detail.state;
      // 'engaged' is a transient flash fired on click, just before navigation.
      if (detail.state === "engaged") {
        resetTimer = setTimeout(() => { compass.dataset.state = "idle"; }, 600);
      }
    });
  }
</script>
