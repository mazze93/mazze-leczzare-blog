---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import displayFontUrl from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import {
  SITE_AUTHOR,
  SITE_DEFAULT_OG_IMAGE,
  SITE_DESCRIPTION,
  SITE_EMAIL,
  SITE_GITHUB_URL,
  SITE_TITLE,
  SITE_TWITTER,
  SITE_URL,
} from '../consts';

interface Props {
title: string;
description: string;
image?: string;
type?: 'website' | 'article';
publishedTime?: string;
modifiedTime?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
  title,
  description,
  image = SITE_DEFAULT_OG_IMAGE,
  type = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;
const ogImageURL = new URL(image, Astro.site ?? SITE_URL);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  publisher: {
    '@type': 'Person',
    name: SITE_AUTHOR,
    url: SITE_URL,
    email: SITE_EMAIL.replace('mailto:', ''),
  },
};
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_AUTHOR,
  url: SITE_URL,
  email: SITE_EMAIL.replace('mailto:', ''),
  sameAs: [
    SITE_URL,
    SITE_GITHUB_URL,
    'https://securepride.org',
    'https://linkedin.com/in/mazze-leczzare',
  ],
  jobTitle: 'Security engineer and content strategist',
  worksFor: { '@type': 'Organization', name: 'Secure Pride' },
  knowsAbout: [
    'Cybersecurity',
    'LGBTQ+ security',
    'AI safety and privacy',
    'Infrastructure systems',
    'Technical writing',
    'Cognitive neuroscience',
    'Developer tools',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Durham',
    addressRegion: 'NC',
    addressCountry: 'US',
  },
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="mask-icon" href="/favicon.svg" color="#5CCFCF" />
<meta name="generator" content={Astro.generator} />

<!-- Theme color (default: dark; updated immediately by inline script below) -->
<meta name="theme-color" content="#0f1210" />
<meta name="color-scheme" content="light dark" />

<!-- Preload critical display font to prevent layout shift -->
<link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL("rss.xml", Astro.site)} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={SITE_AUTHOR} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
{type === 'article' && <meta property="article:author" content={SITE_URL} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:creator" content={SITE_TWITTER} />

<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
<script is:inline data-cfasync="false">
  (() => {
    // These two hexes duplicate --theme-color-dark / --theme-color-light in
    // global.css, deliberately. This script has to run before first paint to
    // set data-theme (that is what prevents the light-mode flash), which means
    // it runs BEFORE Astro's stylesheet <link>s further down the head. At that
    // point getComputedStyle(root).getPropertyValue('--theme-color-dark')
    // returns '' — so the previous version of this block was setting
    // <meta name="theme-color" content=""> on every page load in both themes,
    // and mobile browser chrome fell back to its own default instead of the
    // site's. Reading the tokens is not an option this early; keep these two
    // literals in sync with global.css by hand if the palette moves.
    const THEME_COLOR = { dark: '#0f1210', light: '#f5f0e8' };

    const root = document.documentElement;
    const metaTheme = document.querySelector('meta[name="theme-color"]');

    const apply = (theme) => {
      root.dataset.theme = theme;
      if (metaTheme) metaTheme.setAttribute('content', THEME_COLOR[theme]);
    };

    const stored = localStorage.getItem('theme-preference');
    const query = window.matchMedia('(prefers-color-scheme: dark)');
    const systemTheme = () => (query.matches ? 'dark' : 'light');

    apply(stored === 'light' || stored === 'dark' ? stored : systemTheme());

    // Follow the OS while the visitor has expressed no preference of their own.
    // Without this, "system" only resolved at load: flipping macOS to light
    // with a tab already open left the page dark until a manual reload.
    // A stored preference always wins, so this stops mattering the moment
    // someone uses the toggle.
    query.addEventListener('change', () => {
      if (localStorage.getItem('theme-preference')) return;
      apply(systemTheme());
    });
  })();
</script>
