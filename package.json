{
  "name": "mazze-leczzare-blog",
  "description": "Build a personal website, blog, or portfolio with Astro.",
  "private": true,
  "dependencies": {
    "@astrojs/mdx": "7.0.8",
    "@astrojs/react": "^6.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "astro": "7.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "7.0.2",
    "zod": "^4.4.3"
  },
  "overrides": {
    "esbuild": ">=0.28.1"
  },
  "scripts": {
    "prepare": "cp hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push",
    "astro": "astro",
    "build": "astro build",
    "check": "astro build && tsc",
    "dev": "astro dev",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:check": "bash scripts/ops/verify-docs-integrity.sh && bash scripts/ops/check-docs-drift.sh"
  },
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=11.0.0"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/cormorant-sc": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "playwright": "^1.62.1",
    "vitest": "^4.1.11"
  }
}
