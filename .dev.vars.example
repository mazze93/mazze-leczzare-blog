CONTACT_FROM_EMAIL=contact@mazzeleczzare.com
CONTACT_SUBJECT_PREFIX=Mazze Contact

# ── Required secrets (set via `wrangler secret put` or Cloudflare dashboard) ──
# Plain-text admin password checked by /api/login.
ADMIN_PASSWORD=
# Secret used to sign and verify admin session JWTs (minimum 32 random chars).
JWT_SECRET=
# Verifies Turnstile tokens server-side for /api/contact via siteverify.
# Paired with the public site key hardcoded in src/consts.ts (TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=

# ── Optional secrets ──────────────────────────────────────────────────────────
# POST validated contact payloads to a webhook or Worker endpoint.
CONTACT_WEBHOOK_URL=
# Full Authorization header value expected by the webhook receiver.
CONTACT_WEBHOOK_AUTH_HEADER=

# ── Cloudflare service bindings (not secrets — configure in Cloudflare) ──────
# KV bindings are configured in `wrangler.toml`.
# Route-level rate limiting for `/api/login`, `/api/share-event`, and
# `/api/ingest` should be managed in the Cloudflare dashboard for this Pages
# project. `/api/ingest` writes to the repo — give it a stricter limit.
